+ HydroBase::w_lorentz
+"
+
+#IOASCII::out2D_every     = 256000000
+#IOASCII::out2D_vars      = "
+# GRHydro::bcom
+# GRHydro::bcom0
+# GRHydro::bcom_sq
+# GRHydro::Bcons
