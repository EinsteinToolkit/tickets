From: Erik Schnetter <eschnetter@perimeterinstitute.ca.>
Date: 2011-07-06
Subject: Make table printing functions publicly accessible

The table data types (util_Table.h) have internal routines that print
the table contents to screen. This can be helpful for debugging. This
patch makes these functions publicly available.


Index: include/util_Table.h
===================================================================
--- include/util_Table.h	(revision 4710)
+++ include/util_Table.h	(working copy)
@@ -14,6 +14,10 @@
   @version      $Header$
   @@*/
 
+#ifndef _UTIL_TABLE_H_
+#define _UTIL_TABLE_H_  1       /* define to 1 is Cactus standard */
+                                /* n.b. usual standard is empty defn! */
+
 /*
  * Having this file (a "util_*" low-level file) include a "cctk_*" high-level
  * file is an ugly hack, but we need the CCTK_{INT,REAL,COMPLEX}_* types
@@ -21,10 +25,6 @@
  */
 #include "cctk_Types.h"
 
-#ifndef _UTIL_TABLE_H_
