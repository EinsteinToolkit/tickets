                      (double) value_ptr_complex[i].Re,
                      (double) value_ptr_complex[i].Im);
           }
             }
           break;
+        case CCTK_VARIABLE_CHAR:
+          fprintf(stream, "\t[char]");
+            {
+          const CCTK_CHAR* const value_ptr_char = (const CCTK_CHAR*) tep->value;
+          fprintf(stream, "\t\"");
+          for (i = 0 ; i < tep->N_elements ; ++i)
