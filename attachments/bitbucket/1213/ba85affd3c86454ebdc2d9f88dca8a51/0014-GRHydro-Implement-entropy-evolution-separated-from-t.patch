 {
-  "GRHydro" :: "Use GRHydro to evolve temperature and entropy"
+  "GRHydro" :: "Use GRHydro to evolve temperature"
+}
+EXTENDS KEYWORD entropy_evolution_method ""
+{
+  "GRHydro" :: "Use GRHydro to evolve entropy"
 }
 
