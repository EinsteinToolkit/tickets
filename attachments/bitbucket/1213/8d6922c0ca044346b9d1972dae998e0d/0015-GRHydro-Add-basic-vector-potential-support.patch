+       CCTK_REAL w_lorentz
+       CCTK_REAL gxx, gxy, gxz 
+       CCTK_REAL gyy, gyz, gzz
+       CCTK_REAL uxx, uxy, uxz
+       CCTK_REAL uyy, uyz, uzz
+       CCTK_REAL det
+       CCTK_INT epsnegative
+       CCTK_REAL retval
+     end subroutine  GRHydro_Con2PrimM_Polytype_pt
