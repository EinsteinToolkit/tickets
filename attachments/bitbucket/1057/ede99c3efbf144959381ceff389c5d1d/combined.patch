+  dsy = sqrt(det) * ((drho*(1+deps)+dpress+b2)*w*w * vlowy - &
+       ab0*blowy)
+  dsz = sqrt(det) * ((drho*(1+deps)+dpress+b2)*w*w * vlowz - &
+       ab0*blowz)
