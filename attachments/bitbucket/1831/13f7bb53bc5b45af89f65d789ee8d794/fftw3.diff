 # Configuration definitions for thorn FFTW3
 
+OPTIONAL MPI
+{
+}
+
 PROVIDES FFTW3
 {
   SCRIPT src/detect.sh
   LANG bash
-  OPTIONS FFTW3_DIR FFTW3_INSTALL_DIR FFTW3_LIBS FFTW3_INC_DIRS FFTW3_LIB_DIRS
+  OPTIONS FFTW3_DIR FFTW3_INSTALL_DIR FFTW3_LIBS FFTW3_INC_DIRS FFTW3_LIB_DIRS MPI_DIR MPI_INC_DIRS MPI_LIB_DIRS MPI_LIBS
 }
 
