Index: src/build.sh
===================================================================
--- src/build.sh	(revision 51)
+++ src/build.sh	(working copy)
@@ -47,7 +47,14 @@
 
 echo "FFTW3: Configuring..."
 cd ${NAME}
-./configure --prefix=${FFTW3_DIR}
+enable_mpi=''
+echo BEGIN ENV
+env | sort
+echo END ENV
+if [ -n "${MPI_DIR}" ]; then
+    enable_mpi='--enable-mpi'
+fi
+./configure --prefix=${FFTW3_DIR} ${enable_mpi}
 
 echo "FFTW3: Building..."
 ${MAKE}
