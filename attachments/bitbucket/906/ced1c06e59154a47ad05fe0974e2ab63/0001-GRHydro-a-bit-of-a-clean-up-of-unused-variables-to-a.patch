From 10bb81580723da80cd37f247ad6bf9ee421a6dff Mon Sep 17 00:00:00 2001
From: Bruno Coutinho Mundim <bcmsma@astro.rit.edu>
Date: Thu, 17 May 2012 13:06:25 -0400
Subject: [PATCH] GRHydro: a bit of a clean-up of unused variables to avoid
 compiler complaints.

---
 .../GRHydro/src/GRHydro_Con2PrimM_polytype_pt.c    |   20 ++++++++++----------
 RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_pt.c        |   12 ++++++------
 RITGRMHD/GRHydro/src/GRHydro_Jacobian_state.c      |    1 -
 3 files changed, 16 insertions(+), 17 deletions(-)

diff --git a/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_polytype_pt.c b/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_polytype_pt.c
index 2f3deb2..9fbc042 100644
--- a/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_polytype_pt.c
+++ b/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_polytype_pt.c
@@ -206,14 +206,14 @@ void CCTK_FCALL CCTK_FNAME(GRHydro_Con2PrimM_Polytype_pt)  (
   CCTK_REAL usx, usy, usz;
   CCTK_REAL dens, gammaeos;
   CCTK_REAL QdotB,utsq,gamma_sq;
-  CCTK_REAL rho0,u,p,w,gammasq,gamma,gtmp,W_last,W,vsq;
+  CCTK_REAL rho0,u,p,w,gammasq,gamma,W_last,W,vsq;
   CCTK_REAL g_o_WBsq, QdB_o_W;
   CCTK_REAL rho_g, x_rho[1];
   CCTK_REAL detg = (*det);
   CCTK_REAL sqrt_detg = sqrt(detg);
   CCTK_REAL inv_sqrt_detg = 1./sqrt_detg; 
   CCTK_REAL t2, rho_gm1;
-  CCTK_INT i,j, i_increase,ntries ;
+  CCTK_INT  i_increase,ntries ;
 
   struct LocGlob lg;
 
@@ -492,10 +492,10 @@ static CCTK_INT oned_newton_raphson( CCTK_REAL x[], CCTK_INT n, CCTK_REAL gammae
   CCTK_REAL f, df, dx[1], x_old[1], resid[1], 
     jac[1][1];
   CCTK_REAL errx, x_orig[1];
-  CCTK_INT    n_iter, id, jd, i_extra, doing_extra;
-  CCTK_REAL dW,W,W_old;
+  CCTK_INT    n_iter, i_extra, doing_extra;
+  CCTK_REAL W,W_old;
 
-  CCTK_INT   keep_iterating, i_increase;
+  CCTK_INT   keep_iterating;
 
 
   // Initialize various parameters and variables:
@@ -590,7 +590,7 @@ static CCTK_INT oned_newton_raphson( CCTK_REAL x[], CCTK_INT n, CCTK_REAL gammae
     return(1);
   } 
 
-  return(0);
+  
 
 }
 
@@ -696,8 +696,8 @@ static CCTK_INT gnr2( CCTK_REAL x[], CCTK_INT n, CCTK_REAL gammaeos, struct LocG
   CCTK_REAL f, df, dx[1], x_old[1], resid[1], 
     jac[1][1];
   CCTK_REAL errx, x_orig[1];
-  CCTK_INT    n_iter, id,jd, i_extra, doing_extra;
-  CCTK_REAL dW,W,W_old;
+  CCTK_INT    n_iter, i_extra, doing_extra;
+  
 
   CCTK_INT   keep_iterating;
 
@@ -776,7 +776,7 @@ static CCTK_INT gnr2( CCTK_REAL x[], CCTK_INT n, CCTK_REAL gammaeos, struct LocG
     return(1);
   } 
 
-  return(0);
+  
 
 }
 
@@ -802,7 +802,7 @@ static void func_rho(CCTK_REAL x[], CCTK_REAL dx[], CCTK_REAL resid[],
 		     struct LocGlob *lgp)
 {
 
-  CCTK_REAL A, B, C, rho, W, B0;
+  CCTK_REAL rho, W;
   CCTK_REAL t40,t14;
   
   CCTK_REAL gm1 = gammaeos-1.;
diff --git a/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_pt.c b/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_pt.c
index a26b52d..5dca23b 100644
--- a/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_pt.c
+++ b/RITGRMHD/GRHydro/src/GRHydro_Con2PrimM_pt.c
@@ -216,7 +216,7 @@ void CCTK_FCALL CCTK_FNAME(GRHydro_Con2PrimM_pt)  (
   CCTK_REAL detg = (*det);
   CCTK_REAL sqrt_detg = sqrt(detg);
   CCTK_REAL inv_sqrt_detg = 1./sqrt_detg; 
-  CCTK_INT i,j, i_increase;
+  CCTK_INT  i_increase;
  
   DECLARE_CCTK_PARAMETERS;
  
@@ -458,7 +458,7 @@ static CCTK_REAL vsq_calc(CCTK_REAL W, struct LocGlob *lgp)
 
 static CCTK_REAL x1_of_x0(CCTK_REAL x0, struct LocGlob *lgp ) 
 {
-  CCTK_REAL x1,vsq;
+  CCTK_REAL vsq;
   CCTK_REAL dv = 1.e-15;
 
   vsq = fabs(vsq_calc(x0,lgp)) ; // guaranteed to be positive 
@@ -509,8 +509,8 @@ static CCTK_INT twod_newton_raphson( CCTK_REAL x[], CCTK_REAL gammaeos, struct L
   CCTK_REAL f, df, dx[2], x_old[2];
   CCTK_REAL resid[2], jac[2][2];
   CCTK_REAL errx, x_orig[2];
-  CCTK_INT    n_iter, id, jd, i_extra, doing_extra;
-  CCTK_REAL dW,dvsq,vsq_old,vsq,W,W_old;
+  CCTK_INT    n_iter, i_extra, doing_extra;
+  CCTK_REAL vsq_old,vsq,W,W_old;
   const CCTK_REAL dv = (1.-1.e-15);
 
   CCTK_INT   keep_iterating;
@@ -598,7 +598,7 @@ static CCTK_INT twod_newton_raphson( CCTK_REAL x[], CCTK_REAL gammaeos, struct L
     return(1);
   } 
 
-  return(0);
+  
 
 }
 
@@ -627,7 +627,7 @@ static void func_vsq(CCTK_REAL x[], CCTK_REAL dx[], CCTK_REAL resid[],
 
   
   CCTK_REAL  W, vsq, Wsq, p_tmp, dPdvsq, dPdW;
-  CCTK_REAL t11, t16,t18,t2,t21,   t23,   t24,   t25,   t3,   t35,   t36,   t4,   t40;
+  CCTK_REAL t11, t16,t18,t2,t21,   t23,   t24,   t25,   t3,   t35,  t4,   t40;
 
 
   W = x[0];
diff --git a/RITGRMHD/GRHydro/src/GRHydro_Jacobian_state.c b/RITGRMHD/GRHydro/src/GRHydro_Jacobian_state.c
index 0c26460..55ca1b9 100644
--- a/RITGRMHD/GRHydro/src/GRHydro_Jacobian_state.c
+++ b/RITGRMHD/GRHydro/src/GRHydro_Jacobian_state.c
@@ -16,7 +16,6 @@ GRHydro_check_Jacobian_state (CCTK_ARGUMENTS)
   DECLARE_CCTK_ARGUMENTS
   DECLARE_CCTK_PARAMETERS
 
-  int ierr;
   static CCTK_INT idxJacobian_state = -1, idxiJacobian_state = -1;
 
   if (!CCTK_IsImplementationActive("Coordinates"))
