################################################################################
################################################################################

IO::out_dir  = $parfile

IOASCII::out1D_every            = 1
IOASCII::out1D_x                = "yes"
IOASCII::out1D_y                = "no"
IOASCII::out1D_z                = "no"
IOASCII::out1D_d                = "no"
IOASCII::out1d_xline_y          = -1.5
IOASCII::out1D_vars             = "
        grid::x
