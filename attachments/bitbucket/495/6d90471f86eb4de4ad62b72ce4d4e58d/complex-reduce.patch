+#undef TYPECASE
+#define TYPECASE(N,T)                                           \
+    if (datatype == mpi_datatype<T>()) {                        \
+      T *restrict const invec = (T*)invec_;                     \
+      T *restrict const inoutvec = (T*)inoutvec_;               \
+      for (int n=0; n<len; ++n) {                               \
+        inoutvec[n].Re = min(inoutvec[n].Re, invec[n].Re);      \
