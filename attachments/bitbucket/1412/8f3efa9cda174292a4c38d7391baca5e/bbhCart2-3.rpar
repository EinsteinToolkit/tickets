#!/usr/bin/env python

#   - bbhCart2.rpar
#
#   - This is a modification of bbh.rpar to remove the Llama aspects
#     so it only works on a Cartesian grid.
#   - Also, turn off wave extraction by setting 'Multipole::nradii = 0'
#
#   - Update: This is a cleaned up version of bbhCart.rpar. 
#             Based on the hyp-13 run from my Hyperbolic project
#             -> Turn on pi and planar symmetry: use thorns ReflectionSymmetry 
#                and RotatingSymmetry180
#             -> Removed SphericalSlice 
#             -> turn off CarpetInterp2
#             -> Remove commented thorns and their code:
#                ADMDerivatives, Coordinates, CTGBase, GlobalDerivative
#                Interpolate2, SummationByParts, WaveExtractL, WorldTube
#             -> Output PunctureTracker::pt_vel in addition to position
#             -> Change "static" to "NewRad"
#
#  - Runs on 12 cores on Datura and 16 on Supermuc
#

from math import *
import sys
import re
from string import Template

################################################################################
# Code
################################################################################

# Choose evolution code from CTGamma and McLachlan
evolution_code = "McLachlan"

# Choose Weyl scalar code from Psiclops and WeylScal4
weyl_code = "WeylScal4"

# Choose the mode-decomposition code from Multipole and Psiclops
# (Psiclops only if weyl_code == "Psiclops")
mode_code = "Multipole"

################################################################################
# Initial data
################################################################################

D = 6.0 # Separation
q = 1.0  # Mass ratio
M = 1.0  # Total mass

mp_bare = 0.4765346330240283756
mm_bare = 0.4765346330240283756
give_bare = "no"
mp = M * 1/(1+q)           # Heavier, larger BH, AH1, SS 0
mm = M * q/(1+q)           # Lighter, smaller BH, AH2, SS 1

################################################################################
# Grid structure
################################################################################

# Approximate eventual AH radii
ahrp = mp * 1.0 
ahrm = mm * 1.0

# Number of cells across finest grid radius
n = 24 

# Coordinate size of finest boxes around each BH
rp = ahrp * 1.2
rm = ahrm * 1.2

# Minimum acceptable coarse grid spacing
h0min = 0.96*M

# Smaller BH
hfm = rm/n
rlsm = int(round(log(h0min/hfm,2)))+1
h0 = hfm * 2**(rlsm-1)
levelsm = "\n".join(["CarpetRegrid2::radius_2[%d] = %f" %(l,rm*2**(rlsm-l-1)) for l in range(1,rlsm)])

# Larger BH
hfp = ceil(ahrp/ahrm) * hfm;
rlsp = int(round(log(h0/hfp,2)))+1
levelsp = "\n".join(["CarpetRegrid2::radius_1[%d] = %f" %(l,rp*2**(rlsp-l-1)) for l in range(1,rlsp)])

expected_merger = 100.0
final_time = 1200
half_outer_box_size = 30
half_outer_box_size = int(half_outer_box_size / h0) * h0 + h0 # round up to a multiple of h0

################################################################################

nu = q/(1+q)**2            # Symmetric mass ratio
mu = nu * M                # Reduced mass
Pi = 3.1415926535897932385

# 3 PN conservative circular tangential momentum (see Bruegmann et
# al. 2008 Eq. 65)
pt = mu * (sqrt(M/D) + 2 * (M/D)**(1.5) + 1.0/16.0 * (42.0-43.0*nu) *
        (M/D)**(2.5)+1.0/128.0*(480.0+(163.0 * Pi**2.0-4556.0) * nu+104.0 * nu**2.0) * 
        (M/D)**(3.5))

# For equal mass, add the following from the Husa et al. 2008 Eq. 7
if (q == 1.):
    pt -= 35.0988/(D**(5.36702))
    pr = -1.9188 * (1.76084 - 5.3029/sqrt(D) + 9.06417/D) * D**(-3.288)
else:
    print "Warning: Using a poor approximation for momenta in unequal mass case - you should provide better momentum parameters"

xp     = D * mm
xm     = -D * mp
half_D = D/2.0

center_offset = xp - half_D

Ppx = pr
Ppy = pt
Ppz = 0.
Pmx = -pr
Pmy = -pt
Pmz = 0.

Spx = 0.
Spy = 0.
Spz = 0.
Smx = 0.
Smy = 0.
Smz = 0.

maxrls = 9

dtdx = 0.9*0.5;
k = dtdx*h0/2.0
it_k = k/2.0**(maxrls-2)
find_cah = max(int((expected_merger - 200)/it_k), 0)
wave_extract_every = 2**(maxrls-1) # Every other coarse grid step
horizon_every = 1024
out_every = 4096


################################################################################
# Evolution code
################################################################################

if (evolution_code == "CTGamma"):
    evolution_thorns = """\
      CTGBase
      CTGEvolution
      CTGGauge
      CTGRadiativeBC"""
    evolution_parameters = '''\
      ADMBase::evolution_method               = "ctgamma"
      ADMBase::lapse_evolution_method         = "1+log"
      ADMBase::shift_evolution_method         = "gamma-driver"
      CTGGauge::eta                           = 1
      CTGBase::conformal_factor_type          = "w"
      CTGEvolution::bc                        = "radiative"
      CTGBase::timelevels                     = 3'''

    evolved_groups = """\
      CTGBase::conformal_factor
      CTGBase::conformal_metric
      CTGBase::curvature_scalar
      CTGBase::curvature_tensor
      CTGBase::Gamma
      ADMBase::lapse
      ADMBase::shift"""

    conformal_factor = "CTGBase::conformal_factor"
    extrinsic_curvature = "CTGBase::curvature_scalar"
    outer_boundary_size = 1
    poison = "yes"

elif (evolution_code == "McLachlan"):
    evolution_thorns = '''\
      ML_BSSN
      ML_BSSN_Helper
      NewRad
      GenericFD'''
    outer_boundary_size = 5
    evolution_parameters = '''\
#      GenericFD::jacobian_group = "Coordinates::jacobian"
#      GenericFD::jacobian_derivative_group = "Coordinates::jacobian2"
#      GenericFD::jacobian_identity_map = 0

      ADMBase::evolution_method         = "ML_BSSN"
      ADMBase::lapse_evolution_method   = "ML_BSSN"
      ADMBase::shift_evolution_method   = "ML_BSSN"
      ADMBase::dtlapse_evolution_method = "ML_BSSN"
      ADMBase::dtshift_evolution_method = "ML_BSSN"

      ML_BSSN::harmonicN           = 1      # 1+log
      ML_BSSN::harmonicF           = 2.0    # 1+log
      ML_BSSN::ShiftGammaCoeff     = 0.75
      ML_BSSN::BetaDriver          = 1.0
      ML_BSSN::LapseAdvectionCoeff = 1.0
      ML_BSSN::ShiftAdvectionCoeff = 1.0

      ML_BSSN::MinimumLapse        = 1.0e-8
      ML_BSSN::conformalMethod     = 1 # 1 for W, 0 for phi
      ML_BSSN::apply_dissipation   = never
      ML_BSSN::dt_lapse_shift_method = "noLapseShiftAdvection"
      ML_BSSN::fdOrder             = 8

      ML_BSSN::my_initial_boundary_condition = "extrapolate-gammas"
      ML_BSSN::my_rhs_boundary_condition     = "NewRad"
      Boundary::radpower                           = 2'''

    evolved_groups = '''\
      ML_BSSN::ML_log_confac
      ML_BSSN::ML_metric
      ML_BSSN::ML_trace_curv
      ML_BSSN::ML_curv
      ML_BSSN::ML_Gamma
      ML_BSSN::ML_lapse
      ML_BSSN::ML_shift
      ML_BSSN::ML_dtlapse
      ML_BSSN::ML_dtshift'''

    conformal_factor = "ML_BSSN::ML_log_confac"
    extrinsic_curvature = "ML_BSSN::ML_trace_curv"
    poison = "no"    # Hack needed because Llama does not fill the
                     # interpatch boundary points next to the outer
                     # boundary
else:
    print("Unknown evolution_code '%s'" % evolution_code)

################################################################################
# Weyl Scalar code
################################################################################

if (weyl_code == "Psiclops"):
    weyl_thorns = '''\
      CTGBase
      Psiclops'''
    weyl_parameters = '''\
      Psiclops::store_psi4             = yes
      Psiclops::angular_grid_only      = yes'''

    psi4r = "PsiClops::psi4_re"
    psi4i = "PsiClops::psi4_im"

elif (weyl_code == "WeylScal4"):
    weyl_thorns = '''\
      WeylScal4
      GenericFD'''

    weyl_parameters = '''\
      WeylScal4::fdOrder                  = 8'''

    psi4r = "WeylScal4::Psi4r"
    psi4i = "WeylScal4::Psi4i"

else:
    print("Unknown weyl_code '%s'" % weyl_code)

################################################################################
# Mode decomposition code
################################################################################

if (mode_code == "Psiclops"):
    if (weyl_code != "Psiclops"):
        print "Psiclops mode decomposition is only available if Psiclops is used to compute Psi4"
        sys.exit(1)
    mode_thorns = ""
    mode_parameters = '''\
      Psiclops::nslices                = 7
      Psiclops::which_slice_to_take[0] = 0
      Psiclops::which_slice_to_take[1] = 1
      Psiclops::which_slice_to_take[2] = 2
      Psiclops::which_slice_to_take[3] = 3
      Psiclops::which_slice_to_take[4] = 4
      Psiclops::which_slice_to_take[5] = 5
      Psiclops::which_slice_to_take[6] = 6
      Psiclops::lmax                   = 8'''
    mode_vars = "Psiclops::decomposed_vars"

elif (mode_code == "Multipole"):
    mode_thorns = """\
      Multipole"""
    mode_parameters = '''\
      # Radii are chosen to be evenly spaced in 1/r as that is the variable
      # extrapolation is performed in
      Multipole::nradii       = 0
      Multipole::radius[0]    = 100
      Multipole::radius[1]    = 115
      Multipole::radius[2]    = 136
      Multipole::radius[3]    = 167
      Multipole::radius[4]    = 214
      Multipole::radius[5]    = 300
      Multipole::ntheta       = 120
      Multipole::nphi         = 240
      Multipole::variables    = "WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='psi4'}"
      Multipole::out_every    = ''' + str(wave_extract_every) + '''
      Multipole::l_max        = 8
      Multipole::output_hdf5  = yes
      Multipole::output_ascii = no  # Avoid using a large number of inodes'''    
    mode_vars = ""

else:
    print("Unknown mode_code '%s'" % mode_code)

lines = """

################################################################################
# Active thorns
################################################################################

ActiveThorns = "
  ADMBase
  ADMConstraints
  ADMCoupling
  ADMMacros
  AEILocalInterp
  AHFinderDirect
  Boundary
  Carpet
  CarpetIOASCII
  CarpetIOBasic
  CarpetIOHDF5
  CarpetIOScalar
  CarpetInterp
  CarpetLib
  CarpetReduce
  CarpetRegrid2
  CarpetTracker
  CartGrid3D
  CoordBase
  CoordGauge
  Formaline
  IOUtil
  InitBase
  QuasiLocalMeasures
  LocalInterp
  LoopControl
  TerminationTrigger
  MoL
  NaNChecker
  PunctureTracker
  ReflectionSymmetry
  RotatingSymmetry180
  Slab
  SpaceMask
  SphericalSurface
  StaticConformal
  SymBase
  SystemStatistics
  Time
  TimerReport
  TmunuBase
  TwoPunctures
  Vectors
$evolution_thorns
$weyl_thorns
$mode_thorns
"

################################################################################
# Grid structure
################################################################################

# Coarse grid (refinement level 0)
CartGrid3D::type                        = "coordbase"
Carpet::domain_from_coordbase           = yes
CoordBase::domainsize                   = "minmax"
CoordBase::xmax                         = $half_outer_box_size
CoordBase::ymax                         = $half_outer_box_size
CoordBase::zmax                         = $half_outer_box_size
CoordBase::xmin                         = 0
CoordBase::ymin                         = -$half_outer_box_size
CoordBase::zmin                         = 0
CoordBase::dx                           = $h0
CoordBase::dy                           = $h0
CoordBase::dz                           = $h0
Driver::ghost_size                      = 5

CoordBase::boundary_size_x_upper        = 5
CoordBase::boundary_shiftout_x_upper    = 1
CoordBase::boundary_size_y_upper        = 5
CoordBase::boundary_shiftout_y_upper    = 1
CoordBase::boundary_size_z_upper        = 5
CoordBase::boundary_shiftout_z_upper    = 1

CoordBase::boundary_size_x_lower        = 5
CoordBase::boundary_shiftout_x_lower    = 1
CoordBase::boundary_size_y_lower        = 5
CoordBase::boundary_shiftout_y_lower    = 1
CoordBase::boundary_size_z_lower        = 5
CoordBase::boundary_shiftout_z_lower    = 1


Time::timestep_method                   = "given"
Time::timestep                          = $k
Carpet::time_refinement_factors         = "[1,1,2,4,8,16,32,64,128,256]"

ReflectionSymmetry::reflection_x        = no
ReflectionSymmetry::reflection_y        = no
ReflectionSymmetry::reflection_z        = yes
ReflectionSymmetry::avoid_origin_x      = no
ReflectionSymmetry::avoid_origin_y      = no
ReflectionSymmetry::avoid_origin_z      = no

CarpetRegrid2::symmetry_rotating180     = yes


################################################################################
# Mesh refinement
################################################################################

Carpet::max_refinement_levels           = 9
CarpetRegrid2::num_centres              = 2
CarpetRegrid2::num_levels_1             = $rlsp
CarpetRegrid2::position_x_1             = $xp
$levelsp
CarpetRegrid2::num_levels_2             = $rlsm
CarpetRegrid2::position_x_2             = $xm
$levelsm

Carpet::use_buffer_zones                = yes
Carpet::prolongation_order_space        = 5
Carpet::prolongation_order_time         = 2

CarpetRegrid2::regrid_every             = 128
CarpetRegrid2::verbose                  = yes
Carpet::grid_coordinates_filename       = "carpet-grid.asc"

################################################################################
# Initial data
################################################################################

ADMBase::initial_data                   = "twopunctures"
ADMBase::initial_lapse                  = "twopunctures-averaged"
ADMBase::initial_shift                  = "zero"
ADMBase::initial_dtlapse                = "zero"
ADMBase::initial_dtshift                = "zero"

TwoPunctures::target_M_plus             = $mp
TwoPunctures::target_M_minus            = $mm

TwoPunctures::par_m_plus                = $mp_bare
TwoPunctures::par_m_minus               = $mm_bare

TwoPunctures::par_b                     = $half_D
TwoPunctures::center_offset[0]          = $center_offset

TwoPunctures::par_P_plus[0]             = $Ppx
TwoPunctures::par_P_plus[1]             = $Ppy
TwoPunctures::par_P_plus[2]             = $Ppz

TwoPunctures::par_P_minus[0]            = $Pmx
TwoPunctures::par_P_minus[1]            = $Pmy
TwoPunctures::par_P_minus[2]            = $Pmz

TwoPunctures::par_S_plus[0]             = $Spx
TwoPunctures::par_S_plus[1]             = $Spy
TwoPunctures::par_S_plus[2]             = $Spz

TwoPunctures::par_S_minus[0]            = $Smx
TwoPunctures::par_S_minus[1]            = $Smy
TwoPunctures::par_S_minus[2]            = $Smz

#TwoPunctures::grid_setup_method         = "evaluation"
TwoPunctures::grid_setup_method         = "Taylor Expansion"
TwoPunctures::give_bare_mass            = $give_bare
TwoPunctures::TP_epsilon                = 1e-6
Carpet::init_fill_timelevels            = yes
InitBase::initial_data_setup_method     = "init_single_level"

################################################################################
# Evolution and boundary
################################################################################

$evolution_parameters

################################################################################
# BH tracking
################################################################################

CarpetTracker::surface                      [0] = 0
CarpetTracker::surface                      [1] = 1
PunctureTracker::track                      [0] = yes
PunctureTracker::initial_x                  [0] = $xp
PunctureTracker::which_surface_to_store_info[0] = 0
PunctureTracker::track                      [1] = yes
PunctureTracker::initial_x                  [1] = $xm
PunctureTracker::which_surface_to_store_info[1] = 1


################################################################################
# Time integration
################################################################################

MoL::ODE_Method                         = "rk4"
MoL::MoL_Intermediate_Steps             = 4
MoL::MoL_Num_Scratch_Levels             = 1

################################################################################
# Interpolation
################################################################################

CarpetInterp::check_tree_search         = no
CarpetInterp::tree_search               = yes
# Interpolate::interpolator_order         = 5 # Interpatch interpolation

################################################################################
# Psi4 computation
################################################################################

$weyl_parameters

################################################################################
# Psi4 mode decomposition
################################################################################

$mode_parameters

################################################################################
# Apparent Horizons
################################################################################

AHFinderDirect::N_horizons                               = 2
AHFinderDirect::find_every                               = $horizon_every
AHFinderDirect::output_h_every                           = 0
AHFinderDirect::max_Newton_iterations__initial           = 50
AHFinderDirect::max_Newton_iterations__subsequent        = 50
AHFinderDirect::max_allowable_Theta_growth_iterations    = 10
AHFinderDirect::max_allowable_Theta_nonshrink_iterations = 10
AHFinderDirect::geometry_interpolator_name               = "Lagrange polynomial interpolation"
AHFinderDirect::geometry_interpolator_pars               = "order=4"
AHFinderDirect::surface_interpolator_name                = "Lagrange polynomial interpolation"
AHFinderDirect::surface_interpolator_pars                = "order=4"
AHFinderDirect::verbose_level                            = "physics details"
AHFinderDirect::move_origins                             = yes

AHFinderDirect::origin_x                             [1] = $xp
AHFinderDirect::initial_guess__coord_sphere__x_center[1] = $xp
AHFinderDirect::initial_guess__coord_sphere__radius  [1] = $rp
AHFinderDirect::which_surface_to_store_info          [1] = 2 
AHFinderDirect::set_mask_for_individual_horizon      [1] = no
AHFinderDirect::reset_horizon_after_not_finding      [1] = no
AHFinderDirect::track_origin_from_grid_scalar        [1] = yes
AHFinderDirect::track_origin_source_x                [1] = "PunctureTracker::pt_loc_x[0]"
AHFinderDirect::track_origin_source_y                [1] = "PunctureTracker::pt_loc_y[0]"
AHFinderDirect::track_origin_source_z                [1] = "PunctureTracker::pt_loc_z[0]"
AHFinderDirect::max_allowable_horizon_radius         [1] = 3

AHFinderDirect::origin_x                             [2] = $xm
AHFinderDirect::initial_guess__coord_sphere__x_center[2] = $xm
AHFinderDirect::initial_guess__coord_sphere__radius  [2] = $rm
AHFinderDirect::which_surface_to_store_info          [2] = 3 
AHFinderDirect::set_mask_for_individual_horizon      [2] = no
AHFinderDirect::reset_horizon_after_not_finding      [2] = no
AHFinderDirect::track_origin_from_grid_scalar        [2] = yes
AHFinderDirect::track_origin_source_x                [2] = "PunctureTracker::pt_loc_x[1]"
AHFinderDirect::track_origin_source_y                [2] = "PunctureTracker::pt_loc_y[1]"
AHFinderDirect::track_origin_source_z                [2] = "PunctureTracker::pt_loc_z[1]"
AHFinderDirect::max_allowable_horizon_radius         [2] = 3

AHFinderDirect::origin_x                             [3] = 0
AHFinderDirect::find_after_individual                [3] = 0
AHFinderDirect::initial_guess__coord_sphere__x_center[3] = 0
AHFinderDirect::initial_guess__coord_sphere__radius  [3] = 1.0
AHFinderDirect::which_surface_to_store_info          [3] = 4 
AHFinderDirect::set_mask_for_individual_horizon      [3] = no
AHFinderDirect::max_allowable_horizon_radius         [3] = 6

################################################################################
# Spherical surfaces
################################################################################

SphericalSurface::nsurfaces             = 5
SphericalSurface::maxntheta             = 66
SphericalSurface::maxnphi               = 124
SphericalSurface::verbose               = no

# Surfaces 0 and 1 are used by PunctureTracker

# Horizon 1
SphericalSurface::ntheta            [2] = 41
SphericalSurface::nphi              [2] = 80
SphericalSurface::nghoststheta      [2] = 2
SphericalSurface::nghostsphi        [2] = 2

# Horizon 2
SphericalSurface::ntheta            [3] = 41
SphericalSurface::nphi              [3] = 80
SphericalSurface::nghoststheta      [3] = 2
SphericalSurface::nghostsphi        [3] = 2

# Common horizon
SphericalSurface::ntheta            [4] = 41
SphericalSurface::nphi              [4] = 80
SphericalSurface::nghoststheta      [4] = 2
SphericalSurface::nghostsphi        [4] = 2


################################################################################
# Isolated Horizons
################################################################################

QuasiLocalMeasures::verbose                = yes
QuasiLocalMeasures::veryverbose            = no
QuasiLocalMeasures::interpolator           = "Lagrange polynomial interpolation"
QuasiLocalMeasures::interpolator_options   = "order=4"
QuasiLocalMeasures::spatial_order          = 4
QuasiLocalMeasures::num_surfaces           = 3
QuasiLocalMeasures::surface_index      [0] = 2
QuasiLocalMeasures::surface_index      [1] = 3
QuasiLocalMeasures::surface_index      [2] = 4


################################################################################
# Correctness checking
################################################################################

Carpet::poison_new_timelevels           = $poison
Carpet::check_for_poison                = no

NaNChecker::check_every                 = 256 # Allow time for the nans to appear in the output
NanChecker::check_after                 = 0
NaNChecker::report_max                  = 10
NaNChecker::verbose                     = "all"
NaNChecker::action_if_found             = terminate
NaNChecker::out_NaNmask                 = yes
NaNChecker::check_vars                  = "
  $conformal_factor
"

################################################################################
# Timers
################################################################################

Cactus::cctk_timer_output               = full
TimerReport::out_every                  = $out_every
TimerReport::n_top_timers               = 40
TimerReport::output_all_timers_together = yes
TimerReport::output_schedule_timers     = no

################################################################################
# Output
################################################################################

Cactus::highlight_warning_messages      = "no"

IO::out_dir                             = $$$$parfile
IOScalar::one_file_per_group            = yes
IOASCII::one_file_per_group             = yes

IOBasic::outInfo_every                  = 1
IOBasic::outInfo_reductions             = "minimum maximum"
IOBasic::outInfo_vars                   = "
  $conformal_factor
  Carpet::physical_time_per_hour
  SystemStatistics::maxrss_mb
  SystemStatistics::swap_used_mb
"

IOScalar::outScalar_every               = 256
IOScalar::outScalar_reductions          = "minimum maximum average"
IOScalar::outScalar_vars                = "SystemStatistics::process_memory_mb"

IOASCII::out0D_every                    = 256 
IOASCII::out0D_vars                     = "
  Carpet::timing
  PunctureTracker::pt_loc
  PunctureTracker::pt_vel
  QuasiLocalMeasures::qlm_scalars{out_every = $horizon_every}
"

IOASCII::out1D_every                    = $out_every
IOASCII::out1D_d                        = no
IOASCII::out1D_x                        = yes
IOASCII::out1D_y                        = no
IOASCII::out1D_z                        = yes
IOASCII::out1D_vars                     = "
  $conformal_factor
  $extrinsic_curvature
  $psi4r
"

IOASCII::out2D_every                    = $wave_extract_every
IOASCII::out2D_vars                     = "
  $mode_vars
#  WorldTube::extracted_vars
"

IOHDF5::out_every                       = $out_every
IOHDF5::out_vars                        = "
  Grid::Coordinates
  $conformal_factor
  $extrinsic_curvature
  $psi4r
"

IOHDF5::out2D_every                     = $out_every
IOHDF5::out2D_xz                        = no
IOHDF5::out2D_yz                        = no
IOHDF5::out2D_vars                      = "
  $conformal_factor
  $extrinsic_curvature
  $psi4r
"

################################################################################
# Checkpointing and recovery
################################################################################

CarpetIOHDF5::checkpoint                    = yes
IO::checkpoint_ID                           = no
IO::recover                                 = "autoprobe"
IO::checkpoint_every_walltime_hours         = 3
IO::out_proc_every                          = 2
IO::checkpoint_keep                         = 1
IO::checkpoint_on_terminate                 = yes
IO::checkpoint_dir                          = "../checkpoints"
IO::recover_dir                             = "../checkpoints"
IO::abort_on_io_errors                      = yes
CarpetIOHDF5::open_one_input_file_at_a_time = yes

################################################################################
# Run termination
################################################################################

TerminationTrigger::max_walltime                 = @WALLTIME_HOURS@   # hours
TerminationTrigger::on_remaining_walltime        = 30 # minutes
TerminationTrigger::output_remtime_every_minutes = 5
Cactus::terminate                               = time
Cactus::cctk_final_time                         = $final_time
#Cactus::cctk_itlast                             = 256
"""

open(re.sub(r'(.*)\.rpar$', r'\1.par', sys.argv[0]), 'w').write(re.sub(r'\n *',r'\n',Template(Template(lines).substitute(locals())).substitute(locals())))
