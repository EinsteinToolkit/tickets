+!                 !$OMP END CRITICAL
+                 keyerr(i) = 473
+                 anyerr = 1
+                 return
+              endif
+           enddo
+
+        enddo
+
      case DEFAULT
         write(warnstring,*) "eoskey ",eoskey," not implemented!"
         call CCTK_WARN(0,warnstring)
      end select
 
