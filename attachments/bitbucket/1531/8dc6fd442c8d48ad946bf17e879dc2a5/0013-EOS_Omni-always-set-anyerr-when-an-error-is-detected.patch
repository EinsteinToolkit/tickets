+++ b/src/nuc_eos_cxx/nuc_eos_short.cc
@@ -33,10 +33,14 @@ void CCTK_FNAME(nuc_eos_m_kt1_short)(const int *restrict n_in,
     keyerr[i] = checkbounds(rho[i], temp[i], ye[i]);
     if(keyerr[i] != 0) {
       *anyerr = 1;
