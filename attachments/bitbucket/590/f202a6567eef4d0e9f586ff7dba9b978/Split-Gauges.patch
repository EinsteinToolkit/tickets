+LapseCalc =
+{
+  Name -> thorn <> "_Lapse",
+  Schedule -> {"In " <> thorn <> "_evolCalcGroup " <>
+	       "AFTER (" <> thorn <> "_RHS1 " <> thorn
+                <> "_RHS2) BEFORE (" <> thorn <> "_Advect)"},
+  Conditional -> Parameter["lapse_evolution_method"] == thorn,
+  Where -> InteriorNoSync,
+  Shorthands -> {dir[ua]},
+  Equations ->
+  {
+    dir[ua]    -> Sign[beta[ua]],
+    dot[alpha] -> - harmonicF alpha^harmonicN
+                    (+ LapseACoeff       A
+                     + ((1 - LapseACoeff)
+                        (+ trK - IfCCZ4[2 Theta, 0]
+                         + AlphaDriver (alpha - 1))))
+                  + LapseAdvectionCoeff Upwind[beta[ua], alpha, la],
+
+    dot[A]     -> + (LapseACoeff
+                     (+ dot[trK] - IfCCZ4[2 dot[Theta], 0]
+                      - AlphaDriver A))
+                  + LapseACoeff (
+                    + LapseAdvectionCoeff       Upwind[beta[ua], A, la]
+                    + (1 - LapseAdvectionCoeff) Upwind[beta[ua], trK, la])
+  }
+};
+
+harmonicLapseCalc =
+{
+  Name -> thorn <> "_HarmonicLapse",
+  Schedule -> {"In " <> thorn <> "_evolCalcGroup " <>
+	       "AFTER (" <> thorn <> "_RHS1 " <> thorn <>
+               "_RHS2) BEFORE (" <> thorn <> "_Advect)"},
+  Conditional -> Parameter["lapse_evolution_method"] == thorn <> "_Harmonic",
+  Where -> InteriorNoSync,
+  Shorthands -> {dir[ua]},
+  Equations ->
+  {
+    dir[ua]    -> Sign[beta[ua]],
+    dot[alpha] -> - alpha^2 ( + trK - IfCCZ4[2 Theta, 0]
+                              + AlphaDriver (alpha - 1) )
+                  + LapseAdvectionCoeff Upwind[beta[ua], alpha, la],
+    dot[A]     -> 0
+  }
+};
+
+OnePlusLogLapseCalc =
+{
+  Name -> thorn <> "_1PlusLogLapse",
+  Schedule -> {"In " <> thorn <> "_evolCalcGroup " <>
+	       "AFTER (" <> thorn <> "_RHS1 " <> thorn <>
+               "_RHS2) BEFORE (" <> thorn <> "_Advect)"},
+  Conditional -> Parameter["lapse_evolution_method"] == thorn <> "_1+Log",
+  Where -> InteriorNoSync,
+  Shorthands -> {dir[ua]},
+  Equations ->
+  {
+    dir[ua]    -> Sign[beta[ua]],
+    dot[alpha] -> - 2 alpha ( + trK - IfCCZ4[2 Theta, 0]
+                              + AlphaDriver (alpha - 1) )
+                  + LapseAdvectionCoeff Upwind[beta[ua], alpha, la],
+    dot[A]     -> 0
+  }
+};
+
+ShiftCalc =
+{
+  Name -> thorn <> "_Shift",
+  Schedule -> {"In " <> thorn <> "_evolCalcGroup " <>
+	       "AFTER (" <> thorn <> "_RHS1 " <> thorn <>
+               "_RHS2) BEFORE (" <> thorn <> "_Advect)"},
+  Conditional -> Parameter["shift_evolution_method"] == thorn,
+  Where -> InteriorNoSync,
+  Shorthands -> {dir[ua],detgt,gtu[ua,ub],eta,theta},
+  Equations ->
+  {
+    dir[ua]    -> Sign[beta[ua]],
+
+    detgt -> 1 (* detgtExpr *),
+
+    (* This leads to simpler code... *)
+    gtu[ua,ub]   -> 1/detgt detgtExpr MatrixInverse [gt[ua,ub]],
+
+    eta -> etaExpr,
+    theta -> thetaExpr,
+
+    dot[beta[ua]] -> IfThen[harmonicShift,
+                            - 1/2 gtu[ua,uj] phi alpha
+                              (- 2 alpha PD[phi,lj]
+                               + 2 phi PD[alpha,lj]
+                               + gtu[uk,ul] phi alpha
+                                 (PD[gt[lk,ll],lj] - 2 PD[gt[lj,lk],ll])),
+                            (* else *)
+                            + theta ShiftGammaCoeff
+                              (+ ShiftBCoeff B[ua]
+                               + (1 - ShiftBCoeff)
+                                 (Xt[ua] - eta BetaDriver beta[ua]))]
+                     + ShiftAdvectionCoeff Upwind[beta[ub], beta[ua], lb],
+    dot[B[ua]]    -> + ShiftBCoeff (dot[Xt[ua]] - eta BetaDriver B[ua])
+                     + ShiftBCoeff (
+                       + ShiftAdvectionCoeff Upwind[beta[ub], B[ua], lb]
+                       + ((1 - ShiftAdvectionCoeff)
+                          Upwind[beta[ub], Xt[ua], lb]))
+  }
+};
+
+gamma2ShiftCalc =
+{
+  Name -> thorn <> "_gamma2Shift",
+  Schedule -> {"In " <> thorn <> "_evolCalcGroup " <>
+               "AFTER (" <> thorn <> "_RHS1 " <> thorn <>
+               "_RHS2) BEFORE (" <> thorn <> "_Advect)"},
+  Conditional -> Parameter["shift_evolution_method"] == thorn <> "_gamma2",
+  Where -> InteriorNoSync,
+  Shorthands -> {eta},
+  Equations ->
+  {
+    eta -> etaExpr,
+
+    dot[beta[ua]] -> B[ua],
+    dot[B[ua]]    -> alpha^ShiftAlphaPower*ShiftGammaCoeff*dot[Xt[ua]] - eta B[ua]
+  }
+};
+
