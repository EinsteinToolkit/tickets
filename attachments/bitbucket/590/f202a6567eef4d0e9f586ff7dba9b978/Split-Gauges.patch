+#include "cctk_Parameters.h"
 #include <Slicing.h>
 
 int
 ML_BSSN_RegisterSlicing (void)
 {
-  Einstein_RegisterSlicing ("ML_BSSN");
-  return 0;
+  DECLARE_CCTK_PARAMETERS
+
+  if (CCTK_Equals(lapse_evolution_method, "ML_BSSN"))
+  {
+    Einstein_RegisterSlicing ("ML_BSSN");
+    return 0;
+  }
+  if (CCTK_Equals(lapse_evolution_method, "ML_BSSN_Harmonic"))
+  {
+    Einstein_RegisterSlicing ("ML_BSSN_Harmonic");
+    return 0;
+  }
+  if (CCTK_Equals(lapse_evolution_method, "ML_BSSN_1+Log"))
+  {
+    Einstein_RegisterSlicing ("ML_BSSN_1+Log");
+    return 0;
+  }
 }
