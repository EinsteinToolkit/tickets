From afc54c78944bcb05be7a58654dafa052cc0d2710 Mon Sep 17 00:00:00 2001
From: Christian Reisswig <reisswig@tapir.caltech.edu>
Date: Fri, 10 May 2013 17:37:50 -0700
Subject: [PATCH 13/13] GRHydro: Fix a problem with ghost zones in
 Prim2ConCells calls in MHD case.

---
 src/GRHydro_Prim2ConM.F90 |   18 +++++++++---------
 1 file changed, 9 insertions(+), 9 deletions(-)

diff --git a/src/GRHydro_Prim2ConM.F90 b/src/GRHydro_Prim2ConM.F90
index a6aa09a..ac4a08c 100644
--- a/src/GRHydro_Prim2ConM.F90
+++ b/src/GRHydro_Prim2ConM.F90
@@ -464,9 +464,9 @@ subroutine Primitive2ConservativeCellsM(CCTK_ARGUMENTS)
   if(evolve_temper.ne.1) then
 
   !$OMP PARALLEL DO PRIVATE(k,j,i,det), REDUCTION(MAX:maxtau0)
-  do k = GRHydro_stencil,cctk_lsh(3)-GRHydro_stencil+1
-    do j = GRHydro_stencil,cctk_lsh(2)-GRHydro_stencil+1
-      do i = GRHydro_stencil,cctk_lsh(1)-GRHydro_stencil+1
+  do k = 1,cctk_lsh(3)
+    do j = 1,cctk_lsh(2)
+      do i = 1,cctk_lsh(1)
         
          det = SPATIAL_DETERMINANT(gxx(i,j,k),gxy(i,j,k),gxz(i,j,k), \
               gyy(i,j,k),gyz(i,j,k),gzz(i,j,k))
@@ -505,9 +505,9 @@ subroutine Primitive2ConservativeCellsM(CCTK_ARGUMENTS)
 
   else 
   !$OMP PARALLEL DO PRIVATE(k,j,i,det)
-  do k = GRHydro_stencil,cctk_lsh(3)-GRHydro_stencil+1
-    do j = GRHydro_stencil,cctk_lsh(2)-GRHydro_stencil+1
-      do i = GRHydro_stencil,cctk_lsh(1)-GRHydro_stencil+1
+  do k = 1,cctk_lsh(3)
+    do j = 1,cctk_lsh(2)
+      do i = 1,cctk_lsh(1)
         
          det = SPATIAL_DETERMINANT(gxx(i,j,k),gxy(i,j,k),gxz(i,j,k), \
               gyy(i,j,k),gyz(i,j,k),gzz(i,j,k))
@@ -747,9 +747,9 @@ subroutine Primitive2ConservativePolyCellsM(CCTK_ARGUMENTS)
   CCTK_REAL :: det
   
   !$OMP PARALLEL DO PRIVATE(k,j,i,det)
-  do k = GRHydro_stencil,cctk_lsh(3)-GRHydro_stencil+1
-    do j = GRHydro_stencil,cctk_lsh(2)-GRHydro_stencil+1
-      do i = GRHydro_stencil,cctk_lsh(1)-GRHydro_stencil+1
+  do k = 1,cctk_lsh(3)
+    do j = 1,cctk_lsh(2)
+      do i = 1,cctk_lsh(1)
         
         det = SPATIAL_DETERMINANT(gxx(i,j,k),gxy(i,j,k),gxz(i,j,k),\
              gyy(i,j,k),gyz(i,j,k),gzz(i,j,k))
