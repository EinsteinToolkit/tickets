+        if os.path.exists(scratchdir):
+            fatal("The scratch directory \"%s\" exists already. Scratch directories must be unique to the restart, and will be deleted after the restart finishes. Aborting, because we don't want to risk deleting the wrong directory later on." % scratchdir)
