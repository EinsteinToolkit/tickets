+        defaultscratchdir = simlib.BuildPath(self.RestartDir, 'scratch')
+        scratchdir = simlib.GetMachineOption('scratchdir', defaultscratchdir)
+        scratchdir = DefineDatabase.SubAll(scratchdir)
         
-        if not(os.path.exists(scratchdir)):
