-            if not(scratchdir.startswith("/")):
-                sspath = simlib.BuildPath(self.RestartDir, scratchdir)
-                
-                if not(os.path.exists(sspath)):
-                    try:
-                        # have to rely on os.system due to the possibility of shell expansion 
-                        # annoying.
-                        os.system("mkdir -p %s" % sspath)
-                    except OSError, e:
-                        fatal("Error: could not make scratch directory \"%s\", %s" % (sspath, e))
-                scratchdir = sspath
-            else:
-                try:
