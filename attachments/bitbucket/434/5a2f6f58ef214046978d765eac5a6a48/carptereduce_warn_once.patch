CarpetReduce: warn only once about missmatching volumes

diff -r c82c8535c3e7 -r 418572ade1f1 Carpet/CarpetReduce/src/mask_test.c
--- a/Carpet/CarpetReduce/src/mask_test.c	Fri Sep 30 08:32:21 2011 -0700
+++ b/Carpet/CarpetReduce/src/mask_test.c	Fri Sep 30 21:51:58 2011 -0700
@@ -107,10 +107,12 @@
                   "Simulation domain volume: %.17g", (double)domain_volume);
     }
     
+    static int there_was_a_problem = 0;
     int const there_is_a_problem =
       fabs(sum_weight - domain_volume) > 1.0e-12 * (sum_weight + domain_volume);
     
