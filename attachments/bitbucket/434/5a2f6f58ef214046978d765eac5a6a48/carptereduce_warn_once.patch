       if (!verbose) {
         CCTK_VInfo (CCTK_THORNSTRING,
                     "Simulation domain volume: %.15g", (double)domain_volume);
@@ -118,7 +120,9 @@
                     "Reduction weight sum:     %.15g", (double)sum_weight);
       }
       CCTK_VWarn (CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
