<Group labelreference="L2" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">x := i -&gt; i;</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">Zio2I0kiaUc2IkYlNiRJKW9wZXJhdG9yR0YlSSZhcnJvd0dGJUYlOSRGJUYlRiU=</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L3" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">k:=3; # degree of polynomial interpolating primitive (so one higher than eno order)</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">IiIk</Equation></Text-field>
</Output>
</Group>
<Group labelreference="L4" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">lseq := m -&gt; select(x-&gt;x&lt;&gt;m,[seq(ll,ll=0..k)]);
c := (r,j) -&gt; 2*add(
  ( mul(x(i+1/2)-x(i-r+l),l in lseq(m)) - 
    mul(x(i)-x(i-r+l),l in lseq(m)) ) / 
   mul(x(i-r+m)-x(i-r+l),l in lseq(m))
,m=j+1..k);
</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">Zio2I0kibUc2IkYlNiRJKW9wZXJhdG9yR0YlSSZhcnJvd0dGJUYlLUknc2VsZWN0RyUqcHJvdGVjdGVkRzYkZio2I0kieEdGJUYlRiZGJTA5JFQkRiVGJTYkRiRGMTcjLUkkc2VxR0YrNiRJI2xsR0YlL0Y4OyIiIUkia0dGJUYlRiVGJQ==</Equation></Text-field>
</Output>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
</Group>
<Group labelreference="L5" drawlabel="true">
<Input>
<Text-field prompt="&gt; " style="Maple Input" layout="Normal">for r from 1 to k-1 do
for j from 0 to k-1 do
print(C[r,j],c(r,j))
end do
end do;</Text-field>
</Input>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">NiQmSSJDRzYiNiQiIiIiIiEjRiciIik=</Equation></Text-field>
</Output>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">NiQmSSJDRzYiNiQiIiJGJ0Yn</Equation></Text-field>
</Output>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">NiQmSSJDRzYiNiQiIiIiIiMjISIiIiIp</Equation></Text-field>
</Output>
<Output>
<Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output">NiQmSSJDRzYiNiQiIiMiIiEjISIiIiIp</Equation></Text-field>
</Output>
<Output>
