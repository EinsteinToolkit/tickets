!DESC "Carpet mesh refined, cell-centered, volume based ENO op"
ActiveThorns = "time MoL coordbase symbase cartgrid3d ioutil boundary admbase staticconformal spacemask admcoupling coordgauge admmacros hydrobase grhydro grhydro_initdata tovsolver eos_omni Constants LocalReduce Carpet CarpetLib CarpetInterp CarpetReduce CarpetIOScalar CarpetIOBasic LoopControl TmunuBase InitBase CarpetRegrid2 ReflectionSymmetry CarpetIOASCII CarpetIOHDF5"

TmunuBase::stress_energy_storage	=	yes
TmunuBase::stress_energy_at_RHS		=	yes

time::dtfac = 0.375/2.
Carpet::time_refinement_factors = "[1,1]"

boundary::radpower        = 2

SpaceMask::use_mask = "yes"

CartGrid3D::type         = "coordbase"
CartGrid3D::domain       = "full"
CartGrid3D::avoid_origin = "no"
CoordBase::domainsize = minmax

Carpet::domain_from_coordbase = "yes"
CoordBase::spacing = "numcells"
CoordBase::xmin =  -16.0
CoordBase::ymin =  -16.0
CoordBase::zmin =  -16.0
CoordBase::xmax =   16.0
CoordBase::ymax =   16.0
CoordBase::zmax =   16.0
CoordBase::ncells_x = 16
CoordBase::ncells_y = 16
CoordBase::ncells_z = 16

CoordBase::boundary_size_x_lower        = 3
CoordBase::boundary_size_y_lower        = 3
CoordBase::boundary_size_z_lower        = 3
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_shiftout_z_lower    = 0
CoordBase::boundary_size_x_upper        = 3
CoordBase::boundary_size_y_upper        = 3
CoordBase::boundary_size_z_upper        = 3
CoordBase::boundary_shiftout_x_upper    = 0
CoordBase::boundary_shiftout_y_upper    = 0
CoordBase::boundary_shiftout_z_upper    = 0

CoordBase::boundary_staggered_x_lower    = "yes"
CoordBase::boundary_staggered_y_lower    = "yes"
CoordBase::boundary_staggered_z_lower    = "yes"

CoordBase::boundary_staggered_x_upper    = "yes"
CoordBase::boundary_staggered_y_upper    = "yes"
CoordBase::boundary_staggered_z_upper    = "yes"

Carpet::max_refinement_levels = 2
Carpet::use_buffer_zones      = "no"
CarpetRegrid2::num_centres  = 1
CarpetRegrid2::num_levels_1 = 1
CarpetRegrid2::radius_1[1]  = 7.5

#ActiveThorns = Refluxing

CarpetRegrid2::add_levels_automatically = yes
CarpetRegrid2::regrid_every = 4
CarpetRegrid2::snap_to_coarse = yes
CarpetRegrid2::freeze_unaligned_levels = yes
CarpetRegrid2::freeze_unaligned_parent_levels = yes
CarpetRegrid2::ensure_proper_nesting = yes

Carpet::poison_new_timelevels           = "yes"
Carpet::init_fill_timelevels            = "yes"
CarpetLib::poison_new_memory            = "yes"
Carpet::refinement_centering = "cell"
Carpet::suppress_restriction = "yes"
Carpet::eno_interpolation_type = "averages" #"averages" "samples"

driver::ghost_size   = 3

cactus::cctk_itlast   =       8

methodoflines::ode_method        = "icn"

hydrobase::timelevels             = 3
#hydrobase::evolution_method       = "GRHydro"
hydrobase::prolongation_type      = "ENO"

GRHydro::riemann_solver            = "HLLE"
GRHydro::GRHydro_eos_type           = "Polytype"
GRHydro::GRHydro_eos_table          = "2D_Polytrope"
GRHydro::recon_method              = "tvd"
GRHydro::GRHydro_stencil            = 2
GRHydro::bound                     = "none"
GRHydro::tvd_limiter               = "VanLeerMC2"
GRHydro::rho_abs_min               = 1.e-7
GRHydro::initial_atmosphere_factor = 0.999
# these do not match TOVSolver to make the star actually move
EOS_Omni::poly_gamma = 1.3
EOS_Omni::gl_gamma = 1.3
EOS_Omni::poly_k = 50
EOS_Omni::gl_k = 50
GRHydro::GRHydro_perc_ptol = 1e-5
GRHydro::GRHydro_del_ptol = 1e-5

ADMBase::initial_data  = "tov"
ADMBase::initial_lapse = "tov"
ADMBase::initial_shift = "tov"

tovsolver::TOV_Rho_Central[0] = 1.28e-3
tovsolver::TOV_Gamma[0]       = 2.0
tovsolver::TOV_K[0]           = 100.0
tovsolver::TOV_Combine_Method = "maximum"

Carpet::prolongation_order_space  = 2
Carpet::prolongation_order_time   = 2

IO::out_dir			= $parfile
IO::out_fileinfo                = "all"

IOBasic::outInfo_every = 1
IOBasic::outInfo_vars  = "GRHydro::dens CarpetReduce::weight"
IOBasic::outInfo_reductions  = "sum"

IOASCII::out1D_every = 1
IOASCII::out1D_d     = "no"
IOASCII::out1D_vars  = "grhydro::dens CarpetReduce::weight"

IOSCALAR::outScalar_every = 1
IOSCALAR::outScalar_vars  = "GRHydro::dens CarpetReduce::weight"
IOSCALAR::outScalar_reductions  = "sum"

IOHDF5::out2D_every = 1
IOHDF5::out2D_xy = "yes"
IOHDF5::out2D_xz = "no"
IOHDF5::out2D_yz = "no"
IOHDF5::out2D_vars  = "GRHydro::dens"

IOASCII::out3D_ghosts = "no"
IOASCII::out3D_every = 1
IOASCII::out3D_vars  = "GRHydro::dens CarpetReduce::weight"
