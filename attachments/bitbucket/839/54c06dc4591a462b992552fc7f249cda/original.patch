+      case 1:
+      case 2:
+        dt *= 3.0/4.0;
+        break;
+      case 3:
+      case 4:
+      case 5:
+        dt *= 1.0/2.0;
+        break;
+      case 6:
+      case 7:
+        dt *= 1.0/4.0;
+        break;
+      default:
+        dt = 0;
+    }
+    cctkGH->cctk_time = (*Original_Time) - dt;
+  }
+  else if (CCTK_EQUALS(ODE_Method,"RK4-RK2"))
