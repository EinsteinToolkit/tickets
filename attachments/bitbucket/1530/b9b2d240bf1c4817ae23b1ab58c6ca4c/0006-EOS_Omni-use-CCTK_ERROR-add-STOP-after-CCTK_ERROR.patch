   read(667,"(A30)") buffer1
   if(.not.(trim(adjustl(buffer1)).eq."RhoSpacing = Log")) then
-     call CCTK_WARN(0,"Density spacing not log? Check table format!")
+     call CCTK_ERROR("Density spacing not log? Check table format!")
+     STOP
   endif
 
   ! now read everything
