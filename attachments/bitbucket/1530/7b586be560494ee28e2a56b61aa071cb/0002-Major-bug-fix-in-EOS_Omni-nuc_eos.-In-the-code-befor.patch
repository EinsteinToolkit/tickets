 src/nuc_eos/findtemp.F90     | 191 ++++++++++++++++++++++++++++---------------
 src/nuc_eos/linterp.F        |   6 +-
 src/nuc_eos/linterp_many.F90 |  18 ++--
 src/nuc_eos/nuc_eos.F90      |  63 ++++++++++----
 5 files changed, 190 insertions(+), 92 deletions(-)

