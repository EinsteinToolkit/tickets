+	      exp(lr),exp(lt),ye[i],exp(lxeps));
+#endif
+      nuc_eos_findtemp(lr,lt,ye[i],lxeps,*prec,
+		       (double *restrict)(&ltout),&keyerr[i]);
+    } else {
+      keyerr[i] = 667;
+    } // epstot > 0.0
