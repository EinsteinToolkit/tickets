-         delx(n) = xt(ix) - x(n)
-         dely(n) = 10.0d0**yt(iy) - y(n)
-         delz(n) = zt(iz) - z(n)
-!      
-         fh(n,1) = ft(ix  , iy  , iz)                             
-         fh(n,2) = ft(ix-1, iy  , iz)
-         fh(n,3) = ft(ix  , iy-1, iz)
-         fh(n,4) = ft(ix  , iy  , iz-1)
-         fh(n,5) = ft(ix-1, iy-1, iz)
-         fh(n,6) = ft(ix-1, iy  , iz-1)
-         fh(n,7) = ft(ix  , iy-1, iz-1)
-         fh(n,8) = ft(ix-1, iy-1, iz-1)
