-      dyi   = 1.0d0 / dy
-      dzi   = 1.0d0 / dz
-!
-      dxyi  = dxi * dyi
-      dxzi  = dxi * dzi
-      dyzi  = dyi * dzi
-!
-      dxyzi = dxi * dyi * dzi
