+      {
+	const int iv = 11;
+	nuc_eos_C_linterp_one(idx,delx,dely,delz,&(mun[i]),iv);
+      }
+      // get xa
+      {
+	const int iv = 12;
+	nuc_eos_C_linterp_one(idx,delx,dely,delz,&(xa[i]),iv);
+      }
