+CCTK_REAL *** d3tensor_SIMPLE (long L, long W, long D)
+/* allocate a CCTK_REAL 3tensor with range t[0..nrh-1][0..nch-1][0..ndh-1] */
+{
+  CCTK_REAL ***retval = malloc(L*sizeof(CCTK_REAL **));
+  if(retval == NULL) CCTK_WARN (CCTK_WARN_ABORT, "allocation failure (1) in d3tensor()");
+
+  long i, j;
+
+  for(i=0; i<L; i++){
+    retval[i] = malloc(W*sizeof(CCTK_REAL *));
+    if(retval == NULL) CCTK_WARN (CCTK_WARN_ABORT, "allocation failure (2) in d3tensor()");
+
+    for(j=0; j<W; j++){
+      retval[i][j] = malloc(D*sizeof(CCTK_REAL *));
+      if(retval == NULL) CCTK_WARN (CCTK_WARN_ABORT, "allocation failure (3) in d3tensor()");
+    }
+  }
+
+  return retval;
+}
+
