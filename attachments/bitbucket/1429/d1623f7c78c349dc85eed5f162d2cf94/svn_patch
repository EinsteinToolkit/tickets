+void free_d3tensor_SIMPLE (CCTK_REAL ***t, long L, long W, long D)
+/* free a CCTK_REAL d3tensor allocated by d3tensor_SIMPLE() */
+{
+  long i, j;
+
+  for(i=0; i<L; i++){
+    for(j=0; j<W; j++){
+      free(t[i][j]);
+    }
+    free(t[i]);
+  }
+  free(t);
+
+}
