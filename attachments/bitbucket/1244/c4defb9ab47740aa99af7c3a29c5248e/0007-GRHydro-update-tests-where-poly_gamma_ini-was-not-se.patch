+++ b/test/test_tov_carpet_refined_nosync.par
@@ -85,6 +85,7 @@ GRHydro::rho_abs_min               = 1.e-7
 GRHydro::initial_atmosphere_factor = 0.999
 # these do not match TOVSolver to make the star actually move
