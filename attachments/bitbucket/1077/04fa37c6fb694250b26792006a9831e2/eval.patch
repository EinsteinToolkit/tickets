-!DESC "1+log sliced black hole, BSSN_MoL, Iterative CN"
+!DESC "test triggers"
 
 # Required thorns
 
-ActiveThorns = "time MoL pugh pughreduce pughslab boundary cartgrid3d bssn_mol idanalyticbh ioascii ioutil iobasic admcoupling admbase admmacros coordgauge spacemask staticconformal nanchecker trigger"
+ActiveThorns = "time pugh pughreduce pughslab boundary cartgrid3d wavetoyc idscalarwavec ioascii ioutil iobasic localreduce nanchecker coordbase symbase trigger"
 
 # Grid
 
@@ -12,7 +12,6 @@
 
 grid::type   = "byspacing"
 grid::dxyz   = 0.2
-grid::domain = "octant"
 
 cactus::cctk_initial_time = 0.0
 cactus::cctk_itlast       = 10
@@ -21,39 +20,55 @@
 
