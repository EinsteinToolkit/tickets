CoordBase
IOUtil
InitBase
LoopControl
MoL
Periodic
Slab
SpaceMask
SymBase
SystemStatistics
Time
TimerReport
Vectors
admbase
"

################################################################################
# Grid structure
################################################################################

# Coarse grid (refinement level 0)
CartGrid3D::type                        = "coordbase"
Carpet::domain_from_coordbase           = yes
CoordBase::domainsize                   = "minmax"
CoordBase::xmax                         = 30.4
CoordBase::ymax                         = 30.4
CoordBase::zmax                         = 30.4
CoordBase::xmin                         = 0
CoordBase::ymin                         = 0
CoordBase::zmin                         = 0
CoordBase::dx                           = 0.8
CoordBase::dy                           = 0.8
CoordBase::dz                           = 0.8
Driver::ghost_size                      = 5

CoordBase::boundary_size_x_upper        = 5
CoordBase::boundary_shiftout_x_upper    = 1
CoordBase::boundary_size_y_upper        = 5
CoordBase::boundary_shiftout_y_upper    = 1
CoordBase::boundary_size_z_upper        = 5
CoordBase::boundary_shiftout_z_upper    = 1

CoordBase::boundary_size_x_lower        = 5
CoordBase::boundary_shiftout_x_lower    = 0
CoordBase::boundary_size_y_lower        = 5
CoordBase::boundary_shiftout_y_lower    = 0
CoordBase::boundary_size_z_lower        = 5
CoordBase::boundary_shiftout_z_lower    = 0

Periodic::periodic = yes


Time::timestep_method                   = "given"
Time::timestep                          = 0.18
Carpet::time_refinement_factors         = "[1,1,2,4,8,16,32,64,128,256]"

CarpetRegrid2::symmetry_rotating180     = no

TimerReport::output_all_timers_readable = "yes"
TimerReport::output_all_timers = "yes"
TimerReport::out_every = 2048


################################################################################
# Mesh refinement
################################################################################

Carpet::max_refinement_levels           = 9
CarpetRegrid2::num_centres              = 0
CarpetRegrid2::num_levels_1             = 6
CarpetRegrid2::position_x_1             = 3.0
CarpetRegrid2::radius_1[1] = 9.600000
CarpetRegrid2::radius_1[2] = 4.800000
CarpetRegrid2::radius_1[3] = 2.400000
CarpetRegrid2::radius_1[4] = 1.200000
CarpetRegrid2::radius_1[5] = 0.600000
CarpetRegrid2::num_levels_2             = 6
CarpetRegrid2::position_x_2             = -3.0
CarpetRegrid2::radius_2[1] = 9.600000
CarpetRegrid2::radius_2[2] = 4.800000
CarpetRegrid2::radius_2[3] = 2.400000
CarpetRegrid2::radius_2[4] = 1.200000
CarpetRegrid2::radius_2[5] = 0.600000

Carpet::use_buffer_zones                = yes
Carpet::prolongation_order_space        = 5
Carpet::prolongation_order_time         = 2

CarpetRegrid2::regrid_every             = 128
CarpetRegrid2::verbose                  = no
Carpet::grid_coordinates_filename       = "carpet-grid.asc"

################################################################################
# Initial data
################################################################################

Carpet::init_fill_timelevels            = yes
InitBase::initial_data_setup_method     = "init_single_level"

