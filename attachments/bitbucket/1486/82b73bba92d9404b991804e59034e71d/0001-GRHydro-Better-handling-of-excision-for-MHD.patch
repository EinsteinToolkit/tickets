--- a/src/GRHydro_UpdateMaskM.F90
+++ b/src/GRHydro_UpdateMaskM.F90
@@ -115,6 +115,8 @@ subroutine GRHydro_AtmosphereResetM(CCTK_ARGUMENTS)
           vup(i,j,k,3) = 0.0d0
           sdet = sdetg(i,j,k)
 
+          Bprim(i,j,k,:) = 0.0d0
+          
           if(evolve_temper.ne.0) then
 
              ! set the temperature to be relatively low
