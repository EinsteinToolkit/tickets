+void extrap_kernel (int const* __restrict__ const bmin,
+                    int const* __restrict__ const bmax,
+                    int const* __restrict__ const dir,
+                    double* __restrict__ const var)
+{
+  int const dind = -dir[0] -dir[1]*20 -dir[2]*20*20;
+
+  int imin[3], imax[3], d, i;
+  for (d=0; d<3; ++d) {
+    imin[d] = bmin[d];
+    imax[d] = bmax[d];
+  }
+
+  if(bmin[0] != 2 || imin[0] != 2)
+    exit(1);
+
+  for (i=imin[0]; i!=20; i+=1) {
+    var[0] = var[dind];
+  }
+}
+
+void newrad_extrap_loop(double* const var)
+{
+  int const is_physbnd[6]={1,1,1,1,1,1};
+  int ifec,d;
+
+  for (ifec=1; ifec<=3; ++ifec) {
+    int const dir[3] = { 0, 0, -1 };
+
+    int all_physbnd = 1;
+    int any_physbnd = 0;
+
+    int bmin[3];
+    int bmax[3];
+    for (d=0; d<3; ++d) {
+      switch (dir[d]) {
+      case -1:
+        bmin[d] = 0;
+        bmax[d] = 2;
+        all_physbnd = all_physbnd && is_physbnd[2*d+0];
+        any_physbnd = any_physbnd || is_physbnd[2*d+0];
+        break;
+      case 0:
+        bmin[d] = 2;
+        bmax[d] = 20;
+        break;
+      case +1:
+        bmin[d] = 20;
+        bmax[d] = 40;
+        all_physbnd = all_physbnd && 1;
+        any_physbnd = any_physbnd || 1;
+        break;
+      default:
+        abort();
+      }
+    }
+
+    if (any_physbnd && all_physbnd) {
+     extrap_kernel (bmin, bmax, dir, var);
+    }
+  }
+}
+
+int main()
+{
+  double *bla = (double *)malloc(sizeof(double)*401);
+  newrad_extrap_loop(bla);
+  free(bla);
+  return 0;
