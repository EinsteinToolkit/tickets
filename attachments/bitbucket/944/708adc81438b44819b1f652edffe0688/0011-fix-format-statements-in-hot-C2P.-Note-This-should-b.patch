+++ b/src/GRHydro_Con2Prim.F90
@@ -663,7 +663,7 @@ subroutine Con2Prim_pt_hot(cctk_iteration, ii,jj,kk,handle, dens, &
                  call CCTK_WARN(failinfomode,warnline)
                  write(warnline,"(A7,i8)") "code: ",keyerr(1)
                  call CCTK_WARN(failinfomode,warnline)
-                 write(warnline,"(A10,i5)") "reflevel, iteration: ", GRHydro_reflevel, cctk_iteration
+                 write(warnline,"(A10,i5,i5)") "reflevel, iteration: ", GRHydro_reflevel, cctk_iteration
