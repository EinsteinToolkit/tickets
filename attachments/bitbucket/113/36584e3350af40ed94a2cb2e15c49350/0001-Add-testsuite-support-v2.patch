From: Ian Hinder <ian.hinder@aei.mpg.de>
Date: Sun, 3 Jul 2011 16:27:31 +0200
Subject: [PATCH] Add testsuite support

---
 bin/RunTestSuite           |   16 +++++
 etc/options/sim-manage.ini |   15 +++++
 lib/sim-manage.py          |   15 +++--
 lib/simrestart.py          |  135 ++++++++++++++++++++++++++++++++++---------
 4 files changed, 147 insertions(+), 34 deletions(-)
 create mode 100644 bin/RunTestSuite

diff --git a/bin/RunTestSuite b/bin/RunTestSuite
new file mode 100644
index 0000000..7b6ea0c
--- /dev/null
+++ b/bin/RunTestSuite
@@ -0,0 +1,16 @@
+#!/bin/bash
+
+# Run the test suite.  This script is called from SimRestart.run()
+# with the run script as the only argument.
+
+command="$1"
+
+# This is a hack because the run scripts assume they are in the
+# restart directory, but tests are run from individual directories
+# under TEST
+export CCTK_TESTSUITE_RUN_COMMAND="if [ ! -r output-0000-active ]; then ln -s . output-0000-active; fi; mkdir -p SIMFACTORY && TESTSUITE_PARFILE=\$parfile $command"
+
+# This is the number of MPI processes to run on
+export CCTK_TESTSUITE_RUN_PROCESSORS=@NUM_PROCS@
+
+make @CONFIGURATION@-testsuite PROMPT=no
diff --git a/etc/options/sim-manage.ini b/etc/options/sim-manage.ini
index 4afe0e4..a57e66a 100644
--- a/etc/options/sim-manage.ini
+++ b/etc/options/sim-manage.ini
@@ -53,6 +53,21 @@ argformat = <totalview/ddt>
 argtype = string
 default = totalview
 
+[testsuite]
+long = --testsuite
+desc = Run Cactus testsuite
+negatable = yes
+arg = no
+
+[select-tests]
+long = --select-tests
+desc = Select which tests to run
+negatable = no
+arg = yes
+argtype = string
+default = "all"
+argformat = "all|<test>.par|<arrangement>|<arrangement>/<thorn>"
+
 [restart-id]
 long = --restart-id
 #short
