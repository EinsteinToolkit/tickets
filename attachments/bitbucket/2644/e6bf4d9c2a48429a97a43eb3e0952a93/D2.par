#------------------------------------------------------------------------------
## Wave extraction
##------------------------------------------------------------------------------
ActiveThorns = "WeylScal4 Multipole"

WeylScal4::offset = 1e-8
WeylScal4::fd_order = "4th"
WeylScal4::verbose = 0

Multipole::nradii = 3
Multipole::out_every = 32
Multipole::radius[0] = 80
Multipole::radius[1] = 180
Multipole::radius[2] = 280
Multipole::variables = "WeylScal4::Psi4r{sw=-2 cmplx='WeylScal4::Psi4i' name='Psi4'}"
Multipole::l_max = 4
Multipole::ntheta = 240
Multipole::nphi = 480


#################################################

IOBasic::outInfo_every              = 3200
IOBasic::outInfo_vars               = "Carpet::physical_time_per_hour HydroBase::rho ADMBase::lapse"

IO::out_dir      = $parfile
IO::out_timesteps_per_file          = 1

##------------------------------------------------                                                   
##  Files created by                                                                                 
##    - 0D ASCII output created by CarpetIOASCII                                                     
##    - ASCII output created by CarpetIOScalar                                                       
##  have the seme format                                                                             
##------------------------------------------------                                                   
IOScalar::outScalar_dir  = "${parfile}/data/Scalar"
CarpetIOASCII::out0D_dir = "${parfile}/data/0D"
CarpetIOASCII::out1D_dir = "${parfile}/data/1D"
##------------------------------------------------                                                   
##  Directory for HDF5 output                                                                        
##------------------------------------------------                                                   
CarpetIOHDF5::out_dir    = "${parfile}/data/"
CarpetIOHDF5::out0D_dir = "${parfile}/data/H5_0D"
CarpetIOHDF5::out2D_dir = "${parfile}/data/H5_2D"
CarpetIOHDF5::out3D_dir = "${parfile}/data/H5_3D"

## IOASCII::out0D_every     = 512
## IOASCII::out0D_vars      = "
##  Carpet::timing
##  Hydro_Analysis::Hydro_Analysis_CylDiagnostic
##  Hydro_Analysis::Hydro_Analysis_Quadrupole
##  Hydro_Analysis::Hydro_Analysis_DerivativeQuadrupole
## "

# output just at one point (0D)
CarpetIOASCII::out0D_every = 1024
CarpetIOASCII::compact_format = "yes"
CarpetIOASCII::out0D_point_x = 10.0
CarpetIOASCII::out0D_point_y = 10.0
CarpetIOASCII::out0D_point_z = 10.0
CarpetIOASCII::out0D_vars  = "
 #Carpet::timing
  HydroBase::rho{ refinement_levels=4 }
#  HydroBase::press
  HydroBase::eps{ refinement_levels=4 }
# ML_Boson::ML_Phiboson1
#  QuasiLocalMeasures::qlm_scalars{out_every = 128}
"

IOScalar::outScalar_every = 1024
IOScalar::all_reductions_in_one_file = "yes"
IOScalar::one_file_per_group = "yes"
IOScalar::outScalar_reductions = "minimum maximum average norm1 norm2"
IOScalar::outScalar_vars  = "
  HydroBase::rho
  HydroBase::press
  HydroBase::eps
  HydroBase::vel
  ADMBase::lapse
  ADMBase::metric
  ADMBase::shift
  ADMBase::curv
  ML_ADMConstraints::ML_Ham
  ML_ADMConstraints::ML_mom
 Carpet::timing{reductions='maximum minimum'}
"

