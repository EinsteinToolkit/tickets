##  Hydro_Analysis::Hydro_Analysis_Quadrupole{reductions='maximum'}
##  Hydro_Analysis::Hydro_Analysis_DerivativeQuadrupole{reductions='maximum'}
## ---------------------------------------------

#IOASCII::one_file_per_group = yes
#IOASCII::output_symmetry_points = no
#IOASCII::out3D_ghosts           = no
#IOASCII::out3D_outer_ghosts     = no

IOASCII::out1D_every     = 2048
IOASCII::out1D_vars      = "
  HydroBase::rho
  HydroBase::press
  HydroBase::eps
  HydroBase::vel
  ADMBase::lapse
  ADMBase::metric
  ADMBase::curv
  ML_ADMConstraints::ML_Ham
  ML_ADMConstraints::ML_mom 
"
#

CarpetIOHDF5::one_file_per_group             = "no"   # this is required by multipatch
CarpetIOHDF5::open_one_input_file_at_a_time  = "yes"
#IOHDF5::out_timesteps_per_file         = 1
CarpetIOHDF5::out2D_every                    = 4096   
CarpetIOHDF5::out2D_xy                       = "yes"  # yes
CarpetIOHDF5::out2D_xz                       = "yes"
CarpetIOHDF5::out2D_yz                       = "no"
CarpetIOHDF5::out2D_xyplane_z                = 0.0
CarpetIOHDF5::out2D_vars      = "
  CarpetReduce::weight
  Grid::coordinates
  HydroBase::rho
  HydroBase::vel
  HydroBase::eps
  ADMBase::lapse
  ADMBase::shift
  ADMBase::metric
  ML_ADMConstraints::ML_Ham
"
 

#------------------------------------------------------------------------------
# Timer Report
#------------------------------------------------------------------------------

ActiveThorns = "TimerReport" 

#------------------------------------------------------------------------------
# Termination Trigger
#------------------------------------------------------------------------------

ActiveThorns = "TerminationTrigger"

TerminationTrigger::max_walltime = 96.0
TerminationTrigger::on_remaining_walltime = 30   # minutes
TerminationTrigger::termination_from_file   = "yes"
TerminationTrigger::create_termination_file = "yes"
TerminationTrigger::termination_file        = "./TERMINATE"

#------------------------------------------------------------------------------
# Checkpoint/Recovery:
#------------------------------------------------------------------------------
IOHDF5::checkpoint                  = "yes"
IO::checkpoint_dir                 = ${parfile}
IO::recover_dir                    = ${parfile}
#IO::checkpoint_dir                  = "../CHECKPOINTS"
#IO::recover_dir                     = "../CHECKPOINTS"
IO::checkpoint_ID                   = "no"
IO::checkpoint_every_walltime_hours = 24.0
IO::checkpoint_keep                 = 2
IO::checkpoint_on_terminate         = "yes"
IO::recover     = "autoprobe"



