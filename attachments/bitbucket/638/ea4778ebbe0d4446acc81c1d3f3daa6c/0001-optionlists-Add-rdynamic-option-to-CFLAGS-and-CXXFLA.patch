diff --git a/mdb/optionlists/abe-mvapich2.cfg b/mdb/optionlists/abe-mvapich2.cfg
index 9ef2bca..d1e6efc 100644
--- a/mdb/optionlists/abe-mvapich2.cfg
+++ b/mdb/optionlists/abe-mvapich2.cfg
@@ -13,8 +13,8 @@ F90 = /usr/local/intel/11.1.064/bin/intel64/ifort
 
 CPPFLAGS = -DMPICH_IGNORE_CXX_SEEK
 FPPFLAGS = -traditional
-CFLAGS   = -g -debug all -traceback -align -std=c99 -ansi_alias -U__STRICT_ANSI__
-CXXFLAGS = -g -debug all -traceback -align -restrict
+CFLAGS   = -g -debug all -traceback -align -std=c99 -ansi_alias -U__STRICT_ANSI__ -rdynamic
+CXXFLAGS = -g -debug all -traceback -align -restrict -rdynamic
 F77FLAGS = -g -debug all -traceback -align -pad -w95 -cm
 F90FLAGS = -g -debug all -traceback -align -pad -w95 -cm
 
diff --git a/mdb/optionlists/angel.cfg b/mdb/optionlists/angel.cfg
index 50f98a7..4cf49d6 100644
--- a/mdb/optionlists/angel.cfg
+++ b/mdb/optionlists/angel.cfg
@@ -13,8 +13,8 @@ F90 = /opt/sharcnet/gcc/4.3.4/bin/gfortran
 
 CPPFLAGS = -DMPICH_IGNORE_CXX_SEEK -D__wur=
 FPPFLAGS = -traditional
-CFLAGS   = -g3 -m128bit-long-double -march=native -std=gnu99
-CXXFLAGS = -g3 -m128bit-long-double -march=native -std=gnu++0x
+CFLAGS   = -g3 -m128bit-long-double -march=native -std=gnu99 -rdynamic
+CXXFLAGS = -g3 -m128bit-long-double -march=native -std=gnu++0x -rdynamic
 F77FLAGS = -g3 -m128bit-long-double -march=native -fcray-pointer -ffixed-line-length-none
 F90FLAGS = -g3 -m128bit-long-double -march=native -fcray-pointer -ffixed-line-length-none
 
diff --git a/mdb/optionlists/athena-intel.cfg b/mdb/optionlists/athena-intel.cfg
index b92f2ae..987bc1c 100644
--- a/mdb/optionlists/athena-intel.cfg
+++ b/mdb/optionlists/athena-intel.cfg
@@ -13,8 +13,8 @@ F90 = /opt/intel/Compiler/11.1/038/bin/intel64/ifort
 
 CPPFLAGS = -D__CRAYXT -D__CRAYXT_COMPUTE_LINUX_TARGET -D__TARGET_LINUX__ -DMPICH_IGNORE_CXX_SEEK
 FPPFLAGS = -traditional
-CFLAGS   = -g -debug all -traceback -msse3 -align -std=c99 -ansi_alias -U__STRICT_ANSI__
-CXXFLAGS = -g -debug all -traceback -msse3 -align -restrict -D_intel_fast_memcpy=memcpy -D_intel_fast_memset=memset
+CFLAGS   = -g -debug all -traceback -msse3 -align -std=c99 -ansi_alias -U__STRICT_ANSI__ -rdynamic
+CXXFLAGS = -g -debug all -traceback -msse3 -align -restrict -D_intel_fast_memcpy=memcpy -D_intel_fast_memset=memset -rdynamic
 F77FLAGS = -g -debug all -traceback -msse3 -align -pad -w95 -cm
 F90FLAGS = -g -debug all -traceback -msse3 -align -pad -w95 -cm
 
diff --git a/mdb/optionlists/bethe.cfg b/mdb/optionlists/bethe.cfg
index 2db0bbd..03c4492 100644
--- a/mdb/optionlists/bethe.cfg
+++ b/mdb/optionlists/bethe.cfg
@@ -13,8 +13,8 @@ F90 = /usr/local/apps/intel/intel_fc_11_1/bin/intel64/ifort
 
 CPPFLAGS = -DMPICH_IGNORE_CXX_SEEK
 FPPFLAGS = -traditional
-CFLAGS   = -g -traceback -debug all -xSSE4.2 -align -std=c99 -ansi_alias -U__STRICT_ANSI__
-CXXFLAGS = -g -traceback -debug all -xSSE4.2 -align -std=c99 -restrict
+CFLAGS   = -g -traceback -debug all -xSSE4.2 -align -std=c99 -ansi_alias -U__STRICT_ANSI__ -rdynamic
+CXXFLAGS = -g -traceback -debug all -xSSE4.2 -align -std=c99 -restrict -rdynamic
 F77FLAGS = -g -traceback -debug all -xSSE4.2 -align -pad -w95 -cm
 F90FLAGS = -g -traceback -debug all -xSSE4.2 -align -pad -w95 -cm
 
diff --git a/mdb/optionlists/compute-intel.cfg b/mdb/optionlists/compute-intel.cfg
index cadaf21..2d2d6d8 100644
--- a/mdb/optionlists/compute-intel.cfg
+++ b/mdb/optionlists/compute-intel.cfg
@@ -16,8 +16,8 @@ F90  = ifort
 # Move -g to the debug flags instead.
 CPPFLAGS  = -DOMPI_SKIP_MPICXX
 FPPFLAGS  = -traditional
-CFLAGS    = -g -debug all -traceback -gcc-name=gcc-4.4 -std=c99 -ansi_alias -U__STRICT_ANSI__
-CXXFLAGS  = -g -debug all -traceback -gxx-name=g++-4.4 -restrict -D__builtin_signbit=::signbit
+CFLAGS    = -g -debug all -traceback -gcc-name=gcc-4.4 -std=c99 -ansi_alias -U__STRICT_ANSI__ -rdynamic
+CXXFLAGS  = -g -debug all -traceback -gxx-name=g++-4.4 -restrict -D__builtin_signbit=::signbit -rdynamic
 CUCCFLAGS = -g -debug all -traceback -gxx-name=g++-4.4 -restrict -D__builtin_signbit=::signbit -x c++
 F77FLAGS  = -traceback -pad
 F90FLAGS  = -traceback -pad
