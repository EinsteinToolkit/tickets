+++ configure.sh	(working copy)
@@ -134,8 +134,21 @@
         ${TAR?} xzf ${SRCDIR}/dist/${TARNAME}.tar.gz
         
         echo "PAPI: Applying patches..."
-        pushd ${NAME}
-        # Replace <malloc.h> by <stdlib.h>
+        pushd ${NAME} 
+        ${PATCH?} -p1 < ${SRCDIR}/dist/remove_Werror.patch 
