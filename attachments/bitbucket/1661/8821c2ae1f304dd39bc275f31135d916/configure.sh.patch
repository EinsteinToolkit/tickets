+            echo 'version of the patch command.' 
+            echo 'END ERROR' 
+            exit 1 
+        fi 
+        rm -f .patch_tmp 
         find . -type f -print | xargs perl -pi -e 's/malloc.h/stdlib.h/'
         popd
         
