+        export PKG_CONFIG_PATH=${hwloc_lib_dir}/pkgconfig:${PKG_CONFIG_PATH}
+        # we negate the return code since in perl true == 1 but for the shell true == 0
+        if ( pkg-config hwloc && pkg-config --modversion hwloc | 
