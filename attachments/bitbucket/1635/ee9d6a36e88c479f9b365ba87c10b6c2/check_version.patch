+           ( [ -r ${HWLOC_DIR}/include/hwloc.h ] &&
+             perl -ne 'exit !($1 lt "0x00010600") if m/^#define HWLOC_API_VERSION (.*)/' \
+               ${HWLOC_DIR}/include/hwloc.h ) ; then
+            echo "BEGIN MESSAGE"
+            echo "hwloc too old (require at least version 1.6)"
