+        	    _iorigin_ghosted[d] = _iorigin[d] + _ghosts[2*d];
+        	    _origin_ghosted[d] = _origin[d] + _ghosts[2*d] * _delta[d];
+        	    
+        	    if (_ghosts[2*d] > 0 || _ghosts[2*d+1] > 0)
