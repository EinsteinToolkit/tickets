+bool avtCarpetHDF5FileFormat::file_t::file_changed_on_disk()
+{
+    struct stat s;
+
+    if (stat(filename.c_str(), &s) != 0 || s.st_mtime > mtime) {
+      return true;
+    }
+    if (haveIndex(filename) &&
+        (stat(indexFilename(filename).c_str(), &s) != 0 || s.st_mtime > idx_mtime)) {
+      return true;
+    }
+
+    return false;
+}
