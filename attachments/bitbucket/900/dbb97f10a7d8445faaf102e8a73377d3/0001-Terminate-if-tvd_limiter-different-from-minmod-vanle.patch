From 4aab3139910d2a64f2f28de99480fbce2c7a70b9 Mon Sep 17 00:00:00 2001
From: Bruno Coutinho Mundim <bcmsma@astro.rit.edu>
Date: Mon, 21 May 2012 18:19:28 -0400
Subject: [PATCH] Terminate if tvd_limiter different from minmod, vanleerMC2
 or Superbee.

---
 RITGRMHD/GRHydro/src/GRHydro_ParamCheck.F90 |   10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/RITGRMHD/GRHydro/src/GRHydro_ParamCheck.F90 b/RITGRMHD/GRHydro/src/GRHydro_ParamCheck.F90
index 9310448..f48a7bf 100644
--- a/RITGRMHD/GRHydro/src/GRHydro_ParamCheck.F90
+++ b/RITGRMHD/GRHydro/src/GRHydro_ParamCheck.F90
@@ -41,8 +41,14 @@ subroutine GRHydro_ParamCheck(CCTK_ARGUMENTS)
     call CCTK_PARAMWARN("The stencil is larger than the number of ghost zones. Answer will be dependent on processor number...")
   end if
 
-  if (CCTK_EQUALS(recon_method,"tvd").and.(GRHydro_stencil < 2)) then
-    call CCTK_PARAMWARN("The stencil size must be at least 2 to use TVD reconstruction")
+  if (CCTK_EQUALS(recon_method,"tvd")) then
+    if (GRHydro_stencil < 2) then
+      call CCTK_PARAMWARN("The stencil size must be at least 2 to use TVD reconstruction")
+    end if
+
+    if (CCTK_EQUALS(tvd_limiter,"vanleerMC").or.CCTK_EQUALS(tvd_limiter,"minmod2").or.CCTK_EQUALS(tvd_limiter,"minmod3")) then
+      call CCTK_PARAMWARN("Your choice of tvd_limiter is deprecated. Please choose one among these: minmod, vanleerMC2 or Superbee")
+    end if
   end if
   
   if (CCTK_EQUALS(recon_method,"ppm")) then
-- 
1.7.10.1

