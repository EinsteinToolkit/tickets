 % Do not delete next line
 % START CACTUS THORNGUIDE
 
+\def\arrangement#1{{\bf #1}}		% name of an arrangement
+\def\thorn#1{{\bf #1}}			% name of a thorn
+\def\program#1{{\bf #1}}		% name of computer program
+\newcommand{ \var }[1]{\textsl{\texttt{#1}}}
+\newcommand{ \function }[1]{\texttt{#1}}
+
+\begin{abstract}
+Provides access to the message passing interface MPI, either through a copy
+installed in the system or by compiling a built in copy of
+OpenMPI~\cite{MPI/OpenMPI:web}.
+\end{abstract}
+
+
+\section{Introduction}
+Provides access to the message passing interface MPI, either through a copy
+installed in the system or by compiling a built in copy of
+OpenMPI~\cite{MPI/OpenMPI:web}.
+
+\section{Obtaining and Compiling \thorn{MPI}}
+
+You should be able to obtain the source code for this thorn via the
+usual procedures for anonymous svn checkout; at present it lives in
+the \arrangement{ExternalLibraries} arrangement.
+
+This thorn supports the following configuration options:
+\begin{Lentry}
+\item [\texttt{\var{MPI\_DIR}}] where to search for THORN.
+\item [\texttt{\var{MPI\_LIBS}}] libraries.
+\item [\texttt{\var{MPI\_LIB\_DIRS}}] library directories.
+\item [\texttt{\var{MPI\_INC\_DIRS}}] include file directories.
+\item [\texttt{\var{MPI\_INSTALL\_DIR}}] where to install \texttt{THORN} if the
+      built in copy is used.
+\end{Lentry}
+For details on their meaning please see Section ``Compiling with Extra
+Packages'' of the Cactus  user guide.
+
+\section{Interaction with other thorns}
+Starting from version 2016-05-06 this thorn provides a two functions
+\function{MPI\_Get\_Comm\_World}, \function{MPI\_Get\_Comm\_Universe} (C,
+declared in \verb|MPI_Constants.h|) and \function{Get\_Comm\_World},
+\function{Get\_Comm\_Universe} (Fortran 90, in the \verb|MPI_Constants|
+module). No support is provided for Fortran 77, since Cactus using the Fortran
+90 compiler to compile F77 files.
+
+The thorn provides two compile time preprocessor defines that can be tested in
+C and Fortran code to test for which features are provided.
+\begin{Lentry}
+\item [\var{MPI\_HAVE\_CONSTANTS\_H}] is defined if a file
+\texttt{MPI\_Constants.h} is provided at all.
+\item [\var{MPI\_HAVE\_COMMUNICATORS}] is defined if \texttt{MPI\_Constants.h}
+provides functions to get and set world and universe communicators.
+\end{Lentry}
+
+\subsection{Obtaining the communicators}
+This functionality is provided in an include file \verb|MPI_Constants.h| or
+module \verb|MPI_Constants| to which you gain access by adding
+\verb|REQUIRES MPI| to your thorns's \verb|configuration.ccl| file.
+
+\paragraph{Function prototypes}
+\begin{Lentry}
+\item [C]
+\begin{verbatim}
+MPI_Comm MPI_Get_Comm_World(void);
+MPI_Comm MPI_Get_Comm_Universe(void);
+\end{verbatim}
+
+\item [Fortran 90]
+\begin{verbatim}
+module MPI_Constants
+contains
+function Get_Comm_World()
+  implicit none
+  INTEGER :: Get_Comm_World
+end function Get_Comm_World
+
+function Get_Comm_Universe()
+  implicit none
+  INTEGER :: Get_Comm_World
+end function Get_Comm_Universe
+end module
+\end{verbatim}
+\end{Lentry}
+
+\function{Get\_Comm\_World} returns the world communicator for the model of a
+multi-model simulation that this MPI rank is part of, while
+\function{Get\_Comm\_Universe} returns a truely simulation global
+communicator. If no multi-model simulation is used, both communicators are
+identical and equal to \verb|MPI_COMM_WORLD|.
+
+\subsubsection{Examples}
+\paragraph{C example}
+\begin{verbatim}
+#ifdef MPI_HAVE_CONSTANTS_H_
+#include "MPI_Constants.h"
+#endif
+
+void my_test(CCTK_ARGUMENTS) {
+  /* transparently support old versions of MPI */
+  MPI_Comm world =
+#ifdef MPI_HAVE_COMMUNICATORS
+    MPI_Get_Comm_World();
+#else
+    MPI_COMM_WORLD;
+#endif
+  /* fail on old versions */
+  MPI_Comm universe = MPI_Get_Comm_Universe();
+
+  MPI_Barrier(world);
+  MPI_Barrier(universe);
+}
+\end{verbatim}
+
+\paragraph{Fortran example}
+\begin{verbatim}
+#ifdef MPI_HAVE_CONSTANTS_H_
+#include "MPI_Constants.h"
+#endif
+
+subroutine my_test(CCTK_ARGUMENTS)
+  use MPI_Constants
+  implicit none
+
+  INTEGER :: world, universe
+
+  ! transparently support old versions of MPI
+#ifdef MPI_HAVE_COMMUNICATORS
+  world = Get_Comm_World()
+#else
+  world = MPI_COMM_WORLD
+#endif
+  ! fail on old versions
+  universe = Get_Comm_Universe()
+
+  call MPI_Barrier()
+  call MPI_Barrier()
+end subroutine
+\end{verbatim}
+
+\subsection{Changing the communicators}
+\thorn{MPI} provides a function \function{MPI\_ResetCommunicators} (C,
+declared in \verb|MPI_Constants.h|) and \function{ResetCommunicators} (Fortran
+90, in the \verb|MPI_Constants| module) that let a (driver) thorn reset the
+communicators that \thorn{MPI} provides. The functions simply store the passed
+in communicator handles, and do not make copies via \verb|MPI_Comm_dup|.
+Resetting communicators should happen as early as possible to avoid user
+thorns picking up incorrect communicators.
+
+\paragraph{Function prototypes}
+\begin{Lentry}
+\item [C]
+\begin{verbatim}
+void MPI_ResetCommunicators(MPI_Comm world, MPI_Comm universe);
+\end{verbatim}
+
+\item [Fortran 90]
+\begin{verbatim}
+module MPI_Constants
+contains
+subroutine ResetCommunicators(world, universe)
+  implicit none
+  INTEGER :: world
+  INTEGER :: universe
+end subroutine ResetCommunicators
+end module
+\end{verbatim}
+\end{Lentry}
+
+%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+
+% make LaTeX read in documentation.bbl produced by bibtex
+\bibliographystyle{plain}
+\bibliography{MPI}
+
