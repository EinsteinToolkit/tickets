--- /dev/null
+++ MPI/src/MPI_Constants.F90
@@ -0,0 +1,149 @@
+! @@
+!  @file      MPI_Constants.F90
+!  @date      Mon Apr 25 08:35:50 CEST 2016
+!  @author    Roland Haas
+!  @desc
+!             MPI Communicators
+!  @enddesc
+! @@
+
+#include "cctk.h"
+
+!********************************************************************
+!*********************     Local Data Types   ***********************
+!********************************************************************
+
+!********************************************************************
+!********************* Local Routine Prototypes *********************
+!********************************************************************
+
+!********************************************************************
+!*********************     Local Data   *****************************
+!********************************************************************
+
+!********************************************************************
+!*********************     Global Data   ****************************
+!********************************************************************
+
+module MPI_Constants
+
+  use mpi
+
+  implicit none
+
+  ! the actual communicators. Set via ResetCommunicators(), obtain via
+  ! Get_Comm_World() and Get_Comm_Universe().
+  INTEGER, PRIVATE, SAVE :: Comm_World = MPI_COMM_WORLD
+  INTEGER, PRIVATE, SAVE :: Comm_Universe = MPI_COMM_WORLD
+
+  contains
+  ! @@
+  !  @routine    Get_Comm_World
+  !  @date       Tue Apr 26 09:35:03 CEST 2016
+  !  @author     Roland Haas
+  !  @desc
+  !              Returns the model's world communicator
+  !  @enddesc
+  !  @calls
+  ! @@
+  function Get_Comm_World()
+    implicit none
+    INTEGER :: Get_Comm_World
+    Get_Comm_World = Comm_World
+  end function Get_Comm_World
+
+  ! @@
+  !  @routine    Get_Comm_Universe
+  !  @date       Tue Apr 26 09:35:03 CEST 2016
+  !  @author     Roland Haas
+  !  @desc
+  !              Returns the simulation wide Universe communicator
+  !  @enddesc
+  !  @calls
+  ! @@
+  function Get_Comm_Universe()
+    implicit none
+    INTEGER :: Get_Comm_Universe
+    Get_Comm_Universe = Comm_Universe
+  end function Get_Comm_Universe
+
+  ! @@
+  !  @routine    ResetCommunicators
+  !  @date       Mon Apr 25 09:01:57 CEST 2016
+  !  @author     Roland Haas
+  !  @desc
+  !              Resets the MPI Communicators for use by Cactus.
+  !              Interaction between Fortran and C is rather spaghetti
+  !              like since each language has the actual data in
+  !              private/local objects. When calling the Fortran visible
+  !              Reset function from user code, we need to pass the
+  !              communicators to C to reset the C communicators and
+  !              rely on the C code to call the Fortran glue code to
+  !              reset the actual Fortran communicators (involving yet
+  !              another glue function to gain write access to module
+  !              private members). When the C visible Reset function is
+  !              called from user code we skip the initial Fortran
+  !              routine of course.
+  !  @enddesc
+  !  @calls      MPI_ResetCommunicatorsF2C
+  ! @@
+  subroutine ResetCommunicators(comm_world_, comm_universe_)
+
+    use mpi
+
+    implicit none
+
+    INTEGER, INTENT(IN) :: comm_world_, comm_universe_
+
+    call MPI_ResetCommunicatorsF2C(comm_world_, comm_universe_)
+  end subroutine ResetCommunicators
+
+  ! @@
+  !  @routine    ResetCommunicatorsF
+  !  @date       Mon Apr 25 09:01:57 CEST 2016
+  !  @author     Roland Haas
+  !  @desc
+  !              Resets the MPI Communicators for use by Cactus
+  !              This is an internal glue routine to set members of the module.
+  !  @enddesc
+  !  @calls
+  ! @@
+  subroutine ResetCommunicatorsF(comm_world_, comm_universe_)
+
+    use mpi
+
+    implicit none
+
+    INTEGER, INTENT(IN) :: comm_world_, comm_universe_
+
+    Comm_World = comm_world_
+    Comm_Universe = comm_universe_
+  end subroutine ResetCommunicatorsF
+end module MPI_Constants
+
+!********************************************************************
+!*********************     External Routines   **********************
+!********************************************************************
+
+! @@
+!  @routine    MPI_SeFortranCommunicators
+!  @date       Mon Apr 25 08:41:41 CEST 2016
+!  @author     Roland Haas
+!  @desc
+!              Internal routine that sets MPI Communicators for use by Cactus
+!  @enddesc
+!  @calls
+! @@
+subroutine MPI_SetFortranCommunicators(comm_world_, comm_universe_)
+
+  use MPI_Constants
+
+  implicit none
+
+  INTEGER :: comm_world_, comm_universe_
+
+  call ResetCommunicatorsF(comm_world_, comm_universe_)
+
+end subroutine MPI_SetFortranCommunicators
+
+
