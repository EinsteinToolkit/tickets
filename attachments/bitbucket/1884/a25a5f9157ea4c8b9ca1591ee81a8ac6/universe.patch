+/*@@
+   @file      MPI_Constants.c
+   @date      Mon Apr 25 08:17:10 CEST 2016
+   @author    Roland Haas
+   @desc
+              MPI Communicators
+   @enddesc
+ @@*/
+
+#include "MPI_Constants.h"
+
+#include "cctk.h"
+
+#include <mpi.h>
+
+/********************************************************************
+ *********************     Local Data Types   ***********************
+ ********************************************************************/
+
+/********************************************************************
+ ********************* Local Routine Prototypes *********************
+ ********************************************************************/
+
+/********************************************************************
+ *********************     Local Data   *****************************
+ ********************************************************************/
+
+/* these two represent the communicator among processes in this model and the
+ * truely simulation global communicator. Driver thorns may call
+ * MPI_ResetCommunicator to change these.  */
+static MPI_Comm Comm_World = MPI_COMM_WORLD;
+static MPI_Comm Comm_Universe = MPI_COMM_WORLD;
+
+/********************************************************************
+ *********************     Global Data   ****************************
+ ********************************************************************/
+
+/********************************************************************
+ *********************     External Routines   **********************
+ ********************************************************************/
+
+/* this is a thorn internal routine */
+void CCTK_FCALL
+CCTK_FNAME(MPI_SetFortranCommunicators)(MPI_Fint *comm_world,
+                                        MPI_Fint *comm_univserse);
+
+/********************************************************************
+ *********************     External Routines   **********************
+ ********************************************************************/
+
+ /*@@
+   @routine    MPI_Get_Comm_World
+   @date       Tue Apr 26 09:39:13 CEST 2016
+   @author     Roland Haas
+   @desc
+               Returns the model's world communicator
+   @enddesc
+   @calls
+@@*/
+MPI_Comm MPI_Get_Comm_World(void)
+{
+  return Comm_World;
+}
+
+ /*@@
+   @routine    MPI_Get_Comm_Universe
+   @date       Tue Apr 26 09:39:13 CEST 2016
+   @author     Roland Haas
+   @desc
+               Returns the simulation wide Universe communicator
+   @enddesc
+   @calls
+@@*/
+MPI_Comm MPI_Get_Comm_Universe(void)
+{
+  return Comm_Universe;
+}
+
+ /*@@
+   @routine    MPI_ResetCommunicators
+   @date       Mon Apr 25 08:19:05 CEST 2016
+   @author     Roland Haas
+   @desc
+               Sets up MPI Communicators for use by Cactus
+               Interaction between Fortran and C is rather spaghetti
+               like since each language has the actual data in
+               private/local objects. When calling the Fortran visible
+               Reset function from user code, we need to pass the
+               communicators to C to reset the C communicators and
+               rely on the C code to call the Fortran glue code to
+               reset the actual Fortran communicators (involving yet
+               another glue function to gain write access to module
+               private members). When the C visible Reset function is
+               called from user code we skip the initial Fortran
+               routine of course.
+   @enddesc
+   @calls
+@@*/
+void MPI_ResetCommunicators(MPI_Comm comm_world, MPI_Comm comm_universe)
+{
+  Comm_World = comm_world;
+  Comm_Universe = comm_universe;
+
+  MPI_Fint Fortran_Comm_World = MPI_comm_c2f(Comm_World);
+  MPI_Fint Fortran_Comm_Universe = MPI_comm_c2f(Comm_Universe);
+  CCTK_FNAME(MPI_SetFortranCommunicators)(&Fortran_Comm_World,
+                                          &Fortran_Comm_Universe);
+}
+
+ /*@@
+   @routine    MPI_ResetCommunicatorsF2C
+   @date       Mon Apr 25 09:07:35 CEST 2016
+   @author     Roland Haas
+   @desc
+               Internal glue routine to be called from Fortran to reset
+               communicators.
+   @enddesc
+   @calls
+@@*/
+void CCTK_FCALL CCTK_FNAME(MPI_ResetCommunicatorsF2C)(MPI_Fint *comm_world_,
+                                                      MPI_Fint *comm_universe_)
+{
+  MPI_Comm comm_world = MPI_comm_f2c(*comm_world_);
+  MPI_Comm comm_universe = MPI_comm_f2c(*comm_universe_);
+  MPI_ResetCommunicators(comm_world, comm_universe);
+}
