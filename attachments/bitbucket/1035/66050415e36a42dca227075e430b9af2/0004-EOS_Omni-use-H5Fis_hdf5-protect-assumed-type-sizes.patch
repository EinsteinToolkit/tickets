From d141abf2f6cf364fe70b22d789f02a1ae9aeed98 Mon Sep 17 00:00:00 2001
From: Roland Haas <roland.haas@physics.gatech.edu>
Date: Thu, 9 Aug 2012 02:04:40 -0700
Subject: [PATCH 4/4] EOS_Omni: use H5Fis_hdf5, protect assumed type sizes

---
 src/nuc_eos/readtable.c |   19 +++++--------------
 1 file changed, 5 insertions(+), 14 deletions(-)

diff --git a/src/nuc_eos/readtable.c b/src/nuc_eos/readtable.c
index 973fe23..c9d1d6d 100644
--- a/src/nuc_eos/readtable.c
+++ b/src/nuc_eos/readtable.c
@@ -44,19 +44,6 @@ void CCTK_FNAME(setup_eosmodule)
                   #fn_call, _error_code);                                \
   }
 
-static int file_is_readable(const char* filename);
-static int file_is_readable(const char* filename)
-{
-    FILE* fp = NULL;
-    fp = fopen(filename, "r");
-    if(fp != NULL)
-    {
-        fclose(fp);
-        return 1;
-    }
-    return 0;
-}
-
 // Cactus calls this function. It reads in the table and calls a fortran
 // function to setup values for the fortran eos module
 void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
@@ -76,7 +63,7 @@ void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
                "Requested IO process %d out of range.", reader_process);
 
   hid_t file = -1;
-  if (doIO && !file_is_readable(nuceos_table_name))
+  if (doIO && ! H5Fis_hdf5(nuceos_table_name) > 0)
     CCTK_VWarn(CCTK_WARN_ABORT, __LINE__, __FILE__, CCTK_THORNSTRING,
                "Could not read nuceos_table_name'%s'",
                nuceos_table_name);
@@ -110,6 +97,10 @@ void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
   // Allocate memory for tables
   CCTK_REAL *alltables, *logrho, *logtemp, *ye, energy_shift;
 
+  // protect our use of H5T_NATIVE_DOUBLE and H5T_NATIVE_INT
+  assert (sizeof(CCTK_REAL) == sizeof(double));
+  assert (sizeof(CCTK_INT) == sizeof(int));
+
 #ifdef HAVE_SHMGET
   if (share_table)
   {
-- 
