Index: Kerr.c
===================================================================
--- Kerr.c	(revision 177)
+++ Kerr.c	(working copy)
@@ -112,8 +112,12 @@
     /* Define coordinate functions */
     xx=x[i];  yy=y[i];  zz=z[i];
     rho_2=xx*xx+yy*yy;
-    if (rho_2<epsilon) rho_2=epsilon;
     rho=sqrt(rho_2);
+    if (rho<epsilon) {
+      xx=epsilon;
+      rho_2=xx*xx+yy*yy;
+      rho=sqrt(rho_2);
+    }
     R_2=rho_2+zz*zz;
     R=sqrt(R_2);
     R_3=R*R_2;
