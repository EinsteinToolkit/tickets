From fff73f85bb8902b3c063d5459cecca3dce390dbd Mon Sep 17 00:00:00 2001
From: Roland Haas <roland.haas@physics.gatech.edu>
Date: Sat, 25 Feb 2012 02:17:53 -0800
Subject: [PATCH] add option to use shared memory within a node to only store
 a single copy of the EOS table in memory

---
 param.ccl               |    4 +
 src/nuc_eos/readtable.c |  200 +++++++++++++++++++++++++++++++++++++++++++----
 test/eos_omni.par       |    1 +
 3 files changed, 191 insertions(+), 14 deletions(-)

diff --git a/param.ccl b/param.ccl
index fbe0648..0bb6cf7 100644
--- a/param.ccl
+++ b/param.ccl
@@ -89,6 +89,10 @@ INT reader_process "read table on this process and bcast data" STEERABLE=ALWAYS
   0:* :: "read on process N"
 } 0
 
+BOOLEAN share_table "use shared memory to share the EOS table on a each individual node" STEERABLE=ALWAYS
+{
+} "no"
+
 shares: IO
 
 USES STRING out_dir
diff --git a/src/nuc_eos/readtable.c b/src/nuc_eos/readtable.c
index 37c7472..829c625 100644
--- a/src/nuc_eos/readtable.c
+++ b/src/nuc_eos/readtable.c
@@ -1,4 +1,7 @@
 #include <stdlib.h>
+#include <string.h>
+#include <errno.h>
+#include <assert.h>
 
 #define H5_USE_16_API 1
 #include "hdf5.h"
@@ -7,15 +10,27 @@
 #include "cctk_Parameters.h"
 #include "cctk_Arguments.h"
 #include "cctk_Functions.h"
+#include "cctk_CommandLine.h"
+
+#ifdef HAVE_SHMGET
+#include <sys/types.h>
+#include <sys/ipc.h>
+#include <sys/shm.h>
+#include <sys/sem.h>
+#include <unistd.h>
+#endif
 
 // mini NoMPI
 #ifdef HAVE_CAPABILITY_MPI
 #include <mpi.h>
-#define BCAST(buffer, size) MPI_Bcast(buffer, size, MPI_BYTE, my_reader_process, MPI_COMM_WORLD)
+#define BCAST(buffer, size, root, comm) MPI_Bcast (buffer, size, MPI_BYTE, root, comm)
 #else
-#define BCAST(buffer, size) do { /* do nothing */ } while(0)
+#define BCAST(buffer, size, root, comm) do { /* do nothing */ } while(0)
 #endif
 
+// key used to distinguish ftok keys for the same file
+#define EOS_TABLE_PROJ_ID 42
+
 // Interface of function for fortran module eostable
 void CCTK_FNAME(setup_eosmodule)
                 (CCTK_INT* , CCTK_INT* , CCTK_INT*, CCTK_REAL*,
@@ -31,6 +46,120 @@ void CCTK_FNAME(setup_eosmodule)
                   #fn_call, _error_code);                                \
   }
 
+#ifdef HAVE_SHMGET
+static int get_semaphore(const cGH* cctkGH, int *doIO, int *doBcast)
+{
+  int semid = -1;
+
+  // SYSV IPC requires an existing file to tie IPC objects to
+  char parfile[PATH_MAX+1];
+  CCTK_ParameterFilename(sizeof(parfile), parfile);
+
+  const key_t key = ftok(parfile, EOS_TABLE_PROJ_ID);
+
+  if (key != -1)
+  {
+    semid = semget (key, 2, IPC_CREAT | 0700);
+    if (semid != -1)
+    {
+      struct sembuf sops[2];
+      int nioprocs;
+
+      semctl (semid, 0, SETALL, 0);
+      CCTK_Barrier(cctkGH);       // only way to synchronize initialization of semaphore (what an odd API)
+
+      sops[0].sem_num = 0;        /* Operate on semaphore 0 */
+      sops[0].sem_op = +1;        /* Increment value by one */
+      sops[0].sem_flg = 0;
+
+      sops[1].sem_num = 0;        /* Operate on semaphore 1 */
+      sops[1].sem_op = +1;        /* Increment value by one */
+      sops[1].sem_flg = 0;
+      semop(semid, sops, *doIO ? 2 : 1);
+      CCTK_Barrier(cctkGH);       // semaphore 0 counts the processes
+                                  // semaphore 1 tells if there is an io process on this node
+
+      nioprocs = semctl (semid, 1, GETVAL);
+      if (nioprocs >= 1)
+      { 
+        // use last user selected IO process
+        *doBcast = (semctl (semid, 1, GETPID) == getpid());
+        *doIO = *doBcast;
+      }
+      else
+      {
+        // if there are no IO processes, use the last process on each node 
+        *doBcast = (semctl (semid, 0, GETPID) == getpid());
+      }
+    }
+    else
+    {
+      CCTK_VWarn(CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
+                 "Could not get semaphore segment: %s", strerror(errno));
+    }
+  }
+  else
+  {
+   CCTK_VWarn(CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
+              "Could not create semaphore memory key: %s", strerror(errno));
+  }
+
+  return semid;
+}
+
+static CCTK_REAL *get_shared_segment(cGH cctkGH, size_t size, int semid)
+{
+  DECLARE_CCTK_PARAMETERS;
+
+  CCTK_REAL *retval = NULL;
+  struct semid_ds semid_ds;
+
+  if (semctl (semid, 0, IPC_STAT, &semid_ds) == 0)
+  {
+    const key_t key = semid_ds.sem_perm.__key;
+    const int shmid = shmget(key, size, IPC_CREAT | 0700); // full rw permissions for user, none for anyone else
+    if (shmid != -1)
+    {
+      struct sembuf sops[2];
+
+      void *ptr = shmat(shmid, NULL, 0);
+      if (ptr != (void *) -1)
+      {
+        retval = ptr;
+      }
+      else
+      {
+        CCTK_VWarn(CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
+                   "Could not map shared memory segment: %s", strerror(errno));
+      }
+
+      // register shared memory for deletion so that it is removed when the last process quits
+      sops[0].sem_num = 0;        /* Operate on semaphore 0 */
+      sops[0].sem_op = -1;        /* Decrement value by one */
+      sops[0].sem_flg = 0;
+
+      sops[1].sem_num = 0;        /* Operate on semaphore 0 */
+      sops[1].sem_op = 0;         /* Wait for value to equal 0 */
+      sops[1].sem_flg = 0;
+      semop(semid, sops, 2);
+      shmctl (shmid, IPC_RMID, NULL);
+    }
+    else
+    {
+      CCTK_VWarn(CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
+                 "Could not get shared memory segment: %s", strerror(errno));
+    }
+  }
+  else
+  {
+   CCTK_VWarn(CCTK_WARN_ALERT, __LINE__, __FILE__, CCTK_THORNSTRING,
+              "Could not read out semaphore data structure: %s", strerror(errno));
+  }
+
+  return retval;
+}
+#endif
+
 // Cactus calls this function. It reads in the table and calls a fortran
 // function to setup values for the fortran eos module
 void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
@@ -50,7 +179,15 @@ void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
                "Requested IO process %d out of range. Reverting to process 0.", my_reader_process);
     my_reader_process = 0;
   }
-  const int doIO = !read_table_on_single_process || CCTK_MyProc(cctkGH) == my_reader_process;
+  int doIO = !read_table_on_single_process || CCTK_MyProc(cctkGH) == my_reader_process;
+  int doBcast = 1; // only do MPI Bcast on one process per node if using shared memory
+  int semid = -1;
+  MPI_Comm MyComm = MPI_COMM_WORLD;
+
+#ifdef HAVE_SHMGET
+  semid = get_semaphore(cctkGH, &doIO, &doBcast);
+  MPI_Comm_split (MPI_COMM_WORLD, doBcast, CCTK_MyProc(cctkGH), &MyComm);
+#endif
 
   hid_t file = -1;
   if (doIO && ! H5Fis_hdf5(nuceos_table_name) > 0)
@@ -84,21 +221,50 @@ void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
   READ_BCAST_EOS_HDF5("pointsye",   &nye,   H5T_NATIVE_INT, 1);
 
 
-  // Allocate memory for tables
-  CCTK_REAL *alltables, *logrho, *logtemp, *ye, energy_shift;
-
   // protect our use of H5T_NATIVE_DOUBLE and H5T_NATIVE_INT
   assert (sizeof(CCTK_REAL) == sizeof(double));
   assert (sizeof(CCTK_INT) == sizeof(int));
 
-  if (!(alltables = (CCTK_REAL*)malloc(nrho * ntemp * nye * 19 * sizeof(CCTK_REAL))))
-    CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
-  if (!(logrho = (CCTK_REAL*)malloc(nrho * sizeof(CCTK_REAL))))
-    CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
-  if (!(logtemp = (CCTK_REAL*)malloc(ntemp * sizeof(CCTK_REAL))))
-    CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
-  if (!(ye = (CCTK_REAL*)malloc(nye * sizeof(CCTK_REAL))))
-    CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
+  // Allocate memory for tables
+  CCTK_REAL *alltables = NULL, *logrho = NULL, *logtemp = NULL, *ye = NULL, energy_shift;
+
+#ifdef HAVE_SHMGET
+  if (share_table)
+  {
+      // attempt to allocate a shared memory segment large enough to hold all tables
+      CCTK_VInfo(CCTK_THORNSTRING, "Using shared memory for EOS table.");
+
+      const size_t size = nrho * ntemp * nye * 19 * sizeof(CCTK_REAL) +
+                          nrho * sizeof(CCTK_REAL) +
+                          ntemp * sizeof(CCTK_REAL) +
+                          nye * sizeof(CCTK_REAL);
+      CCTK_REAL *ptr = get_shared_segment(size, semid);
+      if (ptr != NULL)
+      {
+        // divy up into actual tables
+        alltables = ptr;
+        logrho = alltables +  nrho * ntemp * nye * 19;
+        logtemp = logrho + nrho;
+        ye = logtemp + ntemp;
+      }
+  }
+#endif
+  if (alltables == NULL)
+  {
+      // each process on a node gets a separate copy of the EOS table
+      if (share_table)
+        CCTK_VWarn(CCTK_WARN_COMPLAIN, __LINE__, __FILE__, CCTK_THORNSTRING,
+                   "shmget is not avaible. Falling back to non-shared method");
+
+      if (!(alltables = (CCTK_REAL*)malloc(nrho * ntemp * nye * 19 * sizeof(CCTK_REAL))))
+        CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
+      if (!(logrho = (CCTK_REAL*)malloc(nrho * sizeof(CCTK_REAL))))
+        CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
+      if (!(logtemp = (CCTK_REAL*)malloc(ntemp * sizeof(CCTK_REAL))))
+        CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
+      if (!(ye = (CCTK_REAL*)malloc(nye * sizeof(CCTK_REAL))))
+        CCTK_WARN(CCTK_WARN_ABORT, "Cannot allocate memory for EOS table\n");
+  }
 
   // Prepare HDF5 to read hyperslabs into alltables
   hsize_t table_dims[2] = {19, nrho * ntemp * nye};
@@ -142,5 +308,11 @@ void EOS_OMNI_ReadTable(CCTK_ARGUMENTS)
   CCTK_FNAME(setup_eosmodule)
     (&nrho, &ntemp, &nye, alltables, logrho, logtemp, ye, &energy_shift);
 
+#ifdef HAVE_SHMGET
+  if(semid != -1)
+    semctl(semid, 0, IPC_RMID);
+  MPI_Comm_free(MyComm);
+#endif
+
 }
 
diff --git a/test/eos_omni.par b/test/eos_omni.par
index 2ae9cd4..c0fe537 100644
--- a/test/eos_omni.par
+++ b/test/eos_omni.par
@@ -7,6 +7,7 @@ EOS_Omni::dump_nuceos_table_name = "TEST_TABLEEOS_rho4_temp4_ye4_version1.0_2012
 
 EOS_Omni::read_table_on_single_process = yes
 EOS_Omni::reader_process = 1
+EOS_Omni::share_table = 1
 
 IO::out_dir			= $parfile
 
-- 
1.7.10.4

