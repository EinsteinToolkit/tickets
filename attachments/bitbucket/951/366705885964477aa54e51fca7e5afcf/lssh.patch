+\end{SeeAlso}
+\begin{SeeAlso}{CCTK\_GrouplsshGI, CCTK\_GrouplsshGN}
+Returns the local stagger size for a given group.
+\end{SeeAlso}
+\end{SeeAlsoSection}
+\end{FunctionDescription}
