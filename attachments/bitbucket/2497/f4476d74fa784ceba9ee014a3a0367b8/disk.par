LeanBSSNMoL::use_advection_stencils       = yes
LeanBSSNMoL::calculate_constraints        = yes
LeanBSSNMoL::calculate_constraints_every  = 32

# Psi6threshold activates tricks to deplete black holes of matter to
# stabilize the evolution
IllinoisGRMHD::conserv_to_prims_debug     = 0
IllinoisGRMHD::verbose                    = "no"
IllinoisGRMHD::Psi6threshold              = 50
IllinoisGRMHD::neos                       = 1
IllinoisGRMHD::damp_lorenz                = 8
IllinoisGRMHD::update_Tmunu               = "no"

