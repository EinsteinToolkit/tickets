From 58f928ff018c84f80314013bb8f420077f7a7606 Mon Sep 17 00:00:00 2001
From: Barry Wardell <barry.wardell@gmail.com>
Date: Wed, 4 Jan 2012 17:28:40 +0000
Subject: [PATCH] Make output less verbose.

---
 configure.sh |    4 +++-
 1 files changed, 3 insertions(+), 1 deletions(-)

diff --git a/configure.sh b/configure.sh
index dffbb92..1555570 100644
--- a/configure.sh
+++ b/configure.sh
@@ -1,7 +1,9 @@
 #! /bin/bash
 
 # Set up shell
-set -x                          # Output commands
+if [ "$(echo ${VERBOSE} | tr '[:upper:]' '[:lower:]')" = 'yes' ]; then
+    set -x                      # Output commands
+fi
 set -e                          # Abort on errors
 
 
-- 
1.7.7.4

