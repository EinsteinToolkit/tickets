
ActiveThorns = "
        Boundary
        Carpet
        CarpetIOHDF5
        CarpetLib
        CarpetRegrid2
        CartGrid3d
        Coordbase
        IOUtil
        InitBase
        LoopControl
        SymBase
        Time
"

Cactus::terminate       = "iteration"
Cactus::cctk_itlast     = 0

Carpet::init_fill_timelevels = "yes"

Carpet::max_refinement_levels    = 2
driver::ghost_size               =  1
Carpet::prolongation_order_space =  1
Carpet::prolongation_order_time  =  1

Carpet::poison_new_timelevels = "yes"
Carpet::check_for_poison      = "no"
CarpetLib::poison_new_memory  = "yes"
CarpetLib::poison_value       = 114

Carpet::domain_from_coordbase = "yes"

CartGrid3D::type         = "coordbase"
CartGrid3D::avoid_origin = "no"
CoordBase::xmin          =   -10
CoordBase::ymin          =   -10
CoordBase::zmin          =   -10
CoordBase::xmax          =   10.0
CoordBase::ymax          =   10.0
CoordBase::zmax          =   10.0
CoordBase::dx            =   2.0
CoordBase::dy            =   2.0
CoordBase::dz            =   2.0

CoordBase::boundary_size_x_lower     = 1
CoordBase::boundary_size_y_lower     = 1
CoordBase::boundary_size_z_lower     = 1
CoordBase::boundary_size_x_upper     = 1
CoordBase::boundary_size_y_upper     = 1
CoordBase::boundary_size_z_upper     = 1

CarpetRegrid2::verbose      = "yes"
CarpetRegrid2::regrid_every = 0
CarpetRegrid2::boundary_shiftout     = 0
CarpetRegrid2::snap_to_coarse = yes

CarpetRegrid2::num_centres  = 1
CarpetRegrid2::num_levels_1 =  2
CarpetRegrid2::radius_1[1]  = 5

IO::out_dir  = $parfile
IO::verbose  = "full"

CarpetIOHDF5::checkpoint = yes
IO::checkpoint_ID = yes
IO::checkpoint_on_terminate = yes
IO::recover = autoprobe
IO::recover_dir = cp
IO::checkpoint_dir = $parfile
