--- src/Initialisation.c	(revision 30)
+++ src/Initialisation.c	(working copy)
@@ -1,3 +1,5 @@
+#include <math.h>
+#include <assert.h>
 #include <cctk.h>
 #include <cctk_Arguments.h>
 #include <cctk_Parameters.h>
@@ -206,6 +208,92 @@
   else
   {
     CCTK_WARN (CCTK_WARN_ABORT,
+               "unsupported parameter value for initbase::initial_data_setup_method");
+  }
+}
+
+void HydroBase_Bvec_wire (CCTK_ARGUMENTS)
+{
+  DECLARE_CCTK_ARGUMENTS;
+  DECLARE_CCTK_PARAMETERS;
+
+  const CCTK_REAL *x = CCTK_VarDataPtr(cctkGH, 0, "GRID::x"); 
+  const CCTK_REAL *y = CCTK_VarDataPtr(cctkGH, 0, "GRID::y"); 
+  const CCTK_REAL *z = CCTK_VarDataPtr(cctkGH, 0, "GRID::z"); 
+  assert(x);assert(y);assert(z);
+
+  int const np = cctk_lsh[0] * cctk_lsh[1] * cctk_lsh[2];
+  
+  CCTK_REAL dir[3] = {0,0,0};
+  int dirind;
+  if (CCTK_EQUALS(initial_Bvec, "wire z")) {
+    dirind = 2;
+  } else if (CCTK_EQUALS(initial_Bvec, "wire y")) {
+    dirind = 1;
+  } else if (CCTK_EQUALS(initial_Bvec, "wire x")) {
+    dirind = 0;
+  } else {
+    CCTK_WARN (CCTK_WARN_ABORT,
+               "Unsupported parameter value for HydroBase::initial_Bvec");
+    return; /* NOTREACHED */
+  }
+  dir[dirind] = 1.0;
+
+
+#pragma omp parallel for
+  for (int k=0; k<cctk_lsh[2]; ++k) {
+    for (int j=0; j<cctk_lsh[1]; ++j) {
+      for (int i=0; i<cctk_lsh[0]; ++i) {
+        int ind = CCTK_GFINDEX3D(cctkGH, i,j,k);
+        // magnetic field of wire in direction 'dir'
+        CCTK_REAL x0[3] = {x[ind], y[ind], z[ind]};
+        CCTK_REAL s2 = x0[0]*x0[0] + x0[1]*x0[1] + x0[2]*x0[2]; 
+        x0[dirind] = 0.0;
+        
+        if (s2 > 1.0) { // assume a finite sized wire to avoid 1/0 situations
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,0)] = (dir[1]*x0[2]-dir[2]*x0[1])/s2;
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,1)] = (dir[2]*x0[0]-dir[0]*x0[2])/s2;
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,2)] = (dir[0]*x0[1]-dir[1]*x0[0])/s2;
+        } else {
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,0)] = (dir[1]*x0[2]-dir[2]*x0[1]);
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,1)] = (dir[2]*x0[0]-dir[0]*x0[2]);
+          Bvec[CCTK_VECTGFINDEX3D(cctkGH, i,j,k,2)] = (dir[0]*x0[1]-dir[1]*x0[0]);
+        }
+      }
+    }
+  }
+  
+  if (CCTK_EQUALS (initial_data_setup_method, "init_some_levels") ||
+      CCTK_EQUALS (initial_data_setup_method, "init_single_levels"))
+  {
+    /* do nothing */
+  }
+  else if (CCTK_EQUALS (initial_data_setup_method, "init_all_levels"))
+  {
+    
+    if (CCTK_ActiveTimeLevels(cctkGH, "HydroBase::Bvec") >= 2) {
+#pragma omp parallel for
+      for (int i=0; i<3*np; ++i) {
+        Bvec_p[i]      = Bvec[i];
+      }
+    }
+    
+    if (CCTK_ActiveTimeLevels(cctkGH, "HydroBase::Bvec") >= 3) {
+#pragma omp parallel for
+      for (int i=0; i<3*np; ++i) {
+        Bvec_p_p[i]      = Bvec[i];
+      }
+    }
+    
+    if (CCTK_ActiveTimeLevels(cctkGH, "HydroBase::Bvec") >= 4) {
+      CCTK_WARN (CCTK_WARN_ABORT,
+                 "Too many active time levels for HydroBase::Bvec");
+    }
+    
+  }
+  else
+  {
+    CCTK_WARN (CCTK_WARN_ABORT,
                "Unsupported parameter value for InitBase::initial_data_setup_method");
   }
 }
