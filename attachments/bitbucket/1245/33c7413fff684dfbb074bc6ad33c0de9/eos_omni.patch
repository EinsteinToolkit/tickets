+                hybrid_k1 *                     &
                 hybrid_rho_nuc**(hybrid_gamma1 - 1.d0) * rho(i)
            hybrid_p_th = max(zero, hybrid_p_th)
            press(i) = hybrid_p_poly + hybrid_p_th
