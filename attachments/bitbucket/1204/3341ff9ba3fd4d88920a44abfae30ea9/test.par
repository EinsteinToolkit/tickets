CarpetRegrid2::radius_1[7]  =  3.0     # 
CarpetRegrid2::radius_1[8]  =  2.0     # 

CarpetRegrid2::snap_to_coarse = yes


corecollapsecontrol::rho_max_list[0] = 8.0e10
