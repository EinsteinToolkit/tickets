+LIBSZ_DIR   = /cm/shared/apps/zlib/1.2.7
+
+HWLOC_DIR   = /cm/shared/apps/hwloc/1.7.2
+
 FFTW3_DIR   = /cm/shared/apps/fftw/intel/64/3.2.2
 ZLIB_DIR    = /cm/shared/apps/szip/2.1
 BOOST_DIR   = /cm/shared/apps/boost/1.52.0
@@ -95,8 +114,8 @@
