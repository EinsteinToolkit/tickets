-MPI_LIB_DIRS = /cm/shared/apps/slurm/2.4.1/lib /opt/limic2-0.5.5/lib /opt/limic2-0.5.5/lib /cm/shared/apps/mvapich2/intel-12.1/1.8-r5435/lib
+MPI_INC_DIRS = /cm/shared/apps/slurm/2.6.3/include /cm/shared/apps/mvapich2/intel-12.1/1.8-r5435/include
+MPI_LIB_DIRS = /cm/shared/apps/slurm/2.6.3/lib /opt/limic2-0.5.5/lib /opt/limic2-0.5.5/lib /cm/shared/apps/mvapich2/intel-12.1/1.8-r5435/lib
